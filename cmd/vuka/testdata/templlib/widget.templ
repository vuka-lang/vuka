package widget

import "context"

type ButtonProps struct {
	ID         string
	Class      string
	Variant    string
	Attributes templ.Attributes
}

templ Button(props ...ButtonProps) {
	{{ var p ButtonProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<button
		type="button"
		if p.ID != "" {
			id={ p.ID }
		}
		class={ "btn " + p.Class }
		data-variant={ p.Variant }
		{ p.Attributes... }
	>
		{ children... }
	</button>
}

type DialogProps struct {
	ID string
}

templ Dialog(props ...DialogProps) {
	{{ var p DialogProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.ID == "" {
		{{ p.ID = randomID() }}
	}
	{{ ctx = context.WithValue(ctx, dialogKey{}, p.ID) }}
	{ children... }
}

templ Content() {
	{{ id, _ := ctx.Value(dialogKey{}).(string) }}
	<div data-dialog-home>
		<div data-dialog-portal hidden>
			<div id={ id } role="dialog" aria-labelledby={ id + "-title" } class="dialog">
				{ children... }
				<button type="button" data-dialog-close>Close</button>
			</div>
		</div>
	</div>
}

type SelectProps struct {
	ID    string
	Name  string
	Value string
}

templ Select(props ...SelectProps) {
	{{ var p SelectProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.ID == "" {
		{{ p.ID = randomID() }}
	}
	{{ ctx = context.WithValue(ctx, selectKey{}, selectState{id: p.ID, value: p.Value}) }}
	{ children... }
	<input type="hidden" id={ p.ID + "-input" } name={ p.Name } value={ p.Value }/>
}

templ SelectTrigger() {
	{{ s := selectOf(ctx) }}
	<button type="button" id={ s.id + "-trigger" } data-select-trigger={ s.id } aria-expanded="false" aria-controls={ s.id + "-list" }>
		<span data-select-value>{ s.value }</span>
	</button>
}

templ SelectContent() {
	{{ s := selectOf(ctx) }}
	<div data-select-home>
		<div data-select-portal hidden>
			<ul role="listbox" id={ s.id + "-list" }>
				{ children... }
			</ul>
		</div>
	</div>
}

type SelectItemProps struct {
	Value string
}

templ SelectItem(props ...SelectItemProps) {
	{{ var p SelectItemProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	{{ s := selectOf(ctx) }}
	<li role="option" data-value={ p.Value } aria-selected={ boolText(p.Value == s.value) }>
		{ children... }
	</li>
}

func boolText(b bool) string {
	if b {
		return "true"
	}
	return "false"
}

templ Chip(label string, attrs templ.Attributes) {
	<span class="chip" { attrs... }>{ label }</span>
}
