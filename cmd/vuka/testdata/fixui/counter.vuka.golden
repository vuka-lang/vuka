// vuka.Live → ui.Live
// vuka.Node → ui.Node
// vuka.String → ui.String
// github.com/vuka-lang/vuka/v2/live → github.com/vuka-lang/ui/v2/live
// import github.com/vuka-lang/ui/v2

package main

import (
	"context"

	"github.com/vuka-lang/ui/v2/live"
	"github.com/vuka-lang/ui/v2"
)

type Counter struct {
	ui.Live
	Start int
	n     int
}

func (c *Counter) Inc() { c.n++ }

func (c *Counter) Render() ui.Node {
	return <button onClick={c.Inc}>{c.n}</button>
}

func page(ctx context.Context) (string, error) {
	s := live.NewSession(ctx, func(context.Context) ui.Node { return <Counter Start={1} /> })
	_ = s
	return ui.String(ctx, <p>hi</p>)
}

func divide(a, b int) Result[int] {
	if b == 0 {
		return Err[int](errors.New("zero"))
	}
	return Ok(a / b)
}
