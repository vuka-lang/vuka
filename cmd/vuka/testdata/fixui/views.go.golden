// v.Node → ui.Node
// v.TemplComponents → templx.Components
// github.com/vuka-lang/vuka/v2/term → github.com/vuka-lang/ui/v2/term
// import github.com/vuka-lang/ui/v2
// import github.com/vuka-lang/ui/v2/templx

package views

import (
	"context"
	"fmt"

	"github.com/vuka-lang/ui/v2"
	"github.com/vuka-lang/ui/v2/templx"
	"github.com/vuka-lang/ui/v2/term"
	v "github.com/vuka-lang/vuka/v2"
)

type Page struct {
	Title string
	Body  ui.Node
	File  v.File
}

func Show(ctx context.Context, p Page) {
	comps, _ := templx.Components(p.File)
	fmt.Println(len(comps))
	s, _ := term.String(ctx, p.Body, term.Options{})
	fmt.Println(s)
}
