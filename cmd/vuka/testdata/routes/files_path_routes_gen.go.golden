package path

import (
	"net/url"
	"strings"

	"github.com/vuka-lang/web"
)

// IndexURL is the path of the page Index.
func IndexURL(path web.Rest) string {
	segs := strings.Split(string(path), "/")
	for i, seg := range segs {
		segs[i] = url.PathEscape(seg)
	}
	return "/files/" + strings.Join(segs, "/")
}
