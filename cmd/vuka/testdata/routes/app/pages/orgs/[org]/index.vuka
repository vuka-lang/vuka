package org

import (
	"context"
	"io"

	"example.com/app/pages/urls"
)

// Index is an organisation's page.
type Index struct{ Org int }

func NewIndex() *Index { return &Index{} }

func (x *Index) Render(ctx context.Context, w io.Writer) error {
	_, err := io.WriteString(w, urls.Orgs.Org(x.Org).ResetPassword.Path() + urls.Orgs.Org(x.Org).TeamSettings.Path())
	return err
}

func (*Index) Delete(ctx context.Context) error { return nil }
