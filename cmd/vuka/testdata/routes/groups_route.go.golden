package pages

import (
	"example.com/app/pages/admin/auth"
	console "example.com/app/pages/admin/group_console"
	"example.com/app/pages/admin/group_console/users"
	"github.com/vuka-lang/web/v2"
)

// Routes registers every page and endpoint under pages/ on the app, with
// its middleware, guards and layouts: web.New(pages.Routes(), …).
func Routes() web.Option {
	return web.OptionFunc(func(app *web.App) {
		console.VukaRoutes(vukaRoute(app, web.LayoutOf[Layout](), web.GuardOf[console.Guard](), web.LayoutOf[console.Shell]()))
		users.VukaRoutes(vukaRoute(app, web.LayoutOf[Layout](), web.GuardOf[console.Guard](), web.LayoutOf[console.Shell]()))
		auth.VukaRoutes(vukaRoute(app, web.LayoutOf[Layout]()))
	})
}

// vukaRoute registers on app each route a page package's VukaRoutes gives,
// with opts after the route's own.
//
//go:noinline
func vukaRoute(app *web.App, opts ...web.RouteOption) func(kind, method, path string, fn, ctor any, params ...string) {
	return func(kind, method, path string, fn, ctor any, params ...string) {
		opt := web.PageRoute()
		switch kind {
		case "live":
			app.Live(path, fn, append([]web.RouteOption{opt}, opts...)...)
			return
		case "handler":
			opt = web.Receiver(ctor)
		}
		app.Handle(method, path, fn, append([]web.RouteOption{opt}, opts...)...)
	}
}
