// Code generated by vuka from the folders under pages/. DO NOT EDIT.

package pages

import (
	"example.com/app/pages/api"
	api_orgs "example.com/app/pages/api/orgs"
	"example.com/app/pages/api/pets"
	"example.com/app/pages/files"
	"example.com/app/pages/orgs"
	org "example.com/app/pages/orgs/param_org"
	"example.com/app/pages/orgs/param_org/permits"
	"github.com/vuka-lang/vuka/v2"
	"github.com/vuka-lang/web/v2"
)

// Routes registers every page and endpoint under pages/ on the app, with
// its middleware, guards and layouts: web.New(pages.Routes(), …).
func Routes() web.Option {
	return web.OptionFunc(func(app *web.App) {
		VukaRoutes(vukaRoute(app, web.UseOf(Middleware), web.LayoutOf[Layout]()))
		api_orgs.VukaRoutes(vukaRoute(app, web.UseOf(Middleware), web.UseOf(api.Middleware), web.LayoutOf[Layout](), web.GuardOf[api.Guard]()))
		pets.VukaRoutes(vukaRoute(app, web.UseOf(Middleware), web.UseOf(api.Middleware), web.LayoutOf[Layout](), web.GuardOf[api.Guard]()))
		files.VukaRoutes(vukaRoute(app, web.UseOf(Middleware), web.LayoutOf[Layout]()))
		orgs.VukaRoutes(vukaRoute(app, web.UseOf(Middleware), web.LayoutOf[Layout]()))
		org.VukaRoutes(vukaRoute(app, web.UseOf(Middleware), web.LayoutOf[Layout](), web.GuardOf[org.Guard](), web.LayoutOf[org.Layout](), web.ReloadLayout[org.Layout]()))
		permits.VukaRoutes(vukaRoute(app, web.UseOf(Middleware), web.LayoutOf[Layout](), web.GuardOf[org.Guard](), web.LayoutOf[org.Layout](), web.ReloadLayout[org.Layout]()))
	})
}

// vukaRoute registers on app each route a page package's VukaRoutes gives,
// with opts after the route's own.
//
//go:noinline
func vukaRoute(app *web.App, opts ...web.RouteOption) func(name, kind, method, path string, fn, ctor any, params ...string) {
	return func(name, kind, method, path string, fn, ctor any, params ...string) {
		opt := web.PageRoute()
		switch kind {
		case "live":
			app.Live(path, fn, append([]web.RouteOption{opt, web.RouteName(name)}, opts...)...)
			return
		case "handler":
			opt = web.Receiver(ctor)
		case "func":
			if len(params) > 0 {
				vuka.RegisterParams(fn, params...)
			}
		}
		app.Handle(method, path, fn, append([]web.RouteOption{opt, web.RouteName(name)}, opts...)...)
	}
}
