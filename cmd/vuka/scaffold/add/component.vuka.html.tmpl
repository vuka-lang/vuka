package {%.Pkg%}

import "github.com/vuka-lang/ui/v2"

// {%.Name%} is a component: <{%.Name%} title="…">…</{%.Name%}>.
type {%.Name%} struct {
	Title    string
	Class    string
	Children ui.Node
}
<section class={"rounded-2xl p-6 ring-1 ring-slate-900/5 dark:ring-white/10 " + Class}>
  if Title != "" {
    <h2 class="mb-2 text-base font-semibold text-slate-900 dark:text-white">{Title}</h2>
  }
  {Children}
</section>
