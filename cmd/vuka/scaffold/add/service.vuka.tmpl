package {%.Pkg%}

import (
	"context"
	"strings"
)

// {%.Name%} is a service of {%.Pkg%}, registered in main with app.Service:
// pages, routes, hooks and other services take a *{%.Name%} parameter, and the
// app builds it once.
type {%.Name%} struct{}

// New{%.Name%} builds the {%.Name%}; its parameters are its own dependencies,
// filled the same way.
func New{%.Name%}() *{%.Name%} { return &{%.Name%}{} }

// Greet is a sample method: replace it with the service's own.
func ({%.Recv%} *{%.Name%}) Greet(ctx context.Context, name string) string {
	return "Hello, " + strings.TrimSpace(name)
}
