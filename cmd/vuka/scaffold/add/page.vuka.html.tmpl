package {%.Pkg%}
{%- if .Live%}

import "github.com/vuka-lang/ui"

// {%.Type%} is the page at {%.Path%}. It is live: its events change it in
// place, over the page's connection.
type {%.Type%} struct {
	ui.Live
{%- range .Params%}
	{%.Field%} string
{%- end%}
	count int
}

func (p *{%.Type%}) Title() string { return "{%.Title%}" }

// Inc is an event: the button's onClick sends it.
func (p *{%.Type%}) Inc() { p.count++ }
{%- else%}

// {%.Type%} is the page at {%.Path%}{%if .Params%}: its fields are the path's
// parameters{%end%}.
type {%.Type%} struct {
{%- range .Params%}
	{%.Field%} string
{%- end%}
}

func (p *{%.Type%}) Title() string { return "{%.Title%}" }
{%- end%}
{%- if .Document%}
<html lang="en">
  <head><title>{Title()}</title></head>
  <body>
{%- end%}
<main class="mx-auto max-w-2xl px-4 py-16">
  <h1 class="text-2xl font-semibold tracking-tight">{Title()}</h1>
{%- if .Live%}
  <button type="button" class="mt-6 rounded-lg px-3 py-2 ring-1 ring-slate-300" onClick={Inc}>
    Clicked {count} times
  </button>
{%- else%}
  <p class="mt-2 text-sm text-slate-600">Write the page here.</p>
{%- end%}
</main>
{%- if .Document%}
  </body>
</html>
{%- end%}
