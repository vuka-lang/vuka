package {%.Pkg%}

import (
{%- if .Live%}
	"context"
	"strings"

{%- end%}
	"github.com/vuka-lang/ui"
)

// {%.Type%} is the page at {%.Path%}, backed by its component
// ({%.IslandPath%}): the exported fields are what it reads (live.{%.URLJSON%}.value),
// the bound one it sets too{%if .Live%}, and changed runs after it does; it
// is live, so the server keeps the instance and the component gets the new
// props{%end%}.
@ui.Island{%if not .InferIsland%}("{%.IslandPath%}"){%end%}
type {%.Type%} struct {
{%- if .Live%}
	ui.Live
{%- end%}
	{%.Prop%} string   `json:"{%.PropJSON%}"`
{%- if .Live%}
	{%.URLField%}     string   `json:"{%.URLJSON%}"` @ui.URL("{%.URLJSON%}") @ui.Bind // kept in the address (?{%.URLJSON%}=); the component sets it
{%- else%}
	{%.URLField%}     string   `json:"{%.URLJSON%}" url:"{%.URLJSON%}" bind:"{%.URLJSON%}"` // kept in the address (?{%.URLJSON%}=); the component sets it
{%- end%}
	Items []string `json:"items"`
}
{%- if .Live%}

@ui.Mount
func (p *{%.Type%}) mount(ctx context.Context) error {
	p.{%.Prop%} = "{%.Title%}"
	p.filter()
	return nil
}

// changed runs after the component sets {%.URLField%}: live.{%.URLJSON%}.set(v).
@ui.OnChange
func (p *{%.Type%}) changed(ctx context.Context, c ui.Changed) error {
	p.filter()
	return nil
}

func (p *{%.Type%}) filter() {
	p.Items = nil
	for _, it := range []string{"Apples", "Bread", "Coffee"} {
		if strings.Contains(strings.ToLower(it), strings.ToLower(p.{%.URLField%})) {
			p.Items = append(p.Items, it)
		}
	}
}
{%- else%}

func New{%.Type%}() *{%.Type%} {
	return &{%.Type%}{ {%- .Prop%}: "{%.Title%}", Items: []string{"Apples", "Bread", "Coffee"}}
}
{%- end%}
