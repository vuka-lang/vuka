package {%.Pkg%}

import (
	"github.com/vuka-lang/ui"

	{%.Name%}Island "{%.Import%}"
)

// {%.Name%}Props are what <{%.Pkg%}.{%.Name%}> passes to the island.
type {%.Name%}Props struct {
	Title string
	Count int
}

// {%.Name%} places the island {%.File%}: <{%.Pkg%}.{%.Name%} Title="…" />.
func {%.Name%}(p {%.Name%}Props) ui.Node {
	return <{%.Name%}Island title={p.Title} count={p.Count} client:load />
}
