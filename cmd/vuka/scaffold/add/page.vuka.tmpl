package {%.Pkg%}

import (
	"context"
{%- if .Params%}
	"strings"
{%- end%}

	"github.com/vuka-lang/ui"
	"github.com/vuka-lang/web"
{%- if and .Live .Layouts%}

	"{%.Module%}/layouts"
{%- end%}
)
{%- if .Live%}

// {%.Type%} is the page at {%.Path%}, its markup in {%.File%}.vuka.html. It is
// live: its events change it in place, over the page's connection.
@web.Live("{%.Path%}"{%if .Layouts%}, web.Layout(layouts.Page("{%.Title%}")){%end%})
type {%.Type%} struct {
	ui.Live
	count int
}

@ui.Mount
func (p *{%.Type%}) mount(ctx context.Context) error {
	p.count = 0
	return nil
}

// Inc is an event: the button's onClick sends it.
func (p *{%.Type%}) Inc() { p.count++ }
{%- else%}

// {%.Type%} is what the page at {%.Path%} shows, its markup in {%.File%}.vuka.html.
type {%.Type%} struct {
	Title string
{%- range .Params%}
	{%.Field%} string
{%- end%}
}

// {%.Handler%} is GET {%.Path%}.
@web.Get("{%.Path%}")
func {%.Handler%}(ctx context.Context{%range .Params%}, {%.Name%} string{%end%}) ui.Node {
	p := {%.Type%}{Title: "{%.Title%}"{%range .Params%}, {%.Field%}: strings.TrimSpace({%.Name%}){%end%}}
	return p.Render()
}
{%- end%}
