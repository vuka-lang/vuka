package {%.Pkg%}

import (
	"errors"
	"testing"

	"github.com/vuka-lang/orm"
	"github.com/vuka-lang/orm/ormtest"
)

func Test{%.Service%}(t *testing.T) {
	ctx := ormtest.Open(t, orm.Objects[{%.Model%}]()) // a fresh SQLite database with the table
	s := &{%.Service%}{}

	if _, err := s.Add(ctx, New{%.Model%}{Title: "  "}).Get(); !errors.Is(err, ErrNoTitle) {
		t.Errorf("a blank title: %v", err)
	}
	first, err := s.Add(ctx, New{%.Model%}{Title: "First", Body: "Hello"}).Get()
	if err != nil {
		t.Fatal(err)
	}
	if _, err := s.Add(ctx, New{%.Model%}{Title: "Second"}).Get(); err != nil {
		t.Fatal(err)
	}
	all, err := s.All(ctx).Get()
	if err != nil || len(all) != 2 || all[0].Title != "Second" {
		t.Fatalf("All: %v %v", all, err)
	}
	if err := s.Delete(ctx, first.ID); err != nil {
		t.Fatal(err)
	}
	if all, _ := s.All(ctx).Get(); len(all) != 1 {
		t.Errorf("after Delete: %v", all)
	}
}
