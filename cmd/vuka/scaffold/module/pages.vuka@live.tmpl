package {%.Pkg%}

import (
	"context"

	"github.com/vuka-lang/ui"
	"github.com/vuka-lang/web"
{%- if .Auth%}
	"github.com/vuka-lang/web/auth"
{%- end%}

	"{%.Module%}/layouts"
)

var _ = layouts.Nav(layouts.Link{Label: "{%.Label%}", Href: "{%.Path%}", Icon: "book", Order: 20})

// Page lists the {%.Pkg%}, with a form to add one (page.vuka.html). It is
// live: adding and deleting change the page in place.
@web.Live("{%.Path%}", web.Layout(layouts.Page("{%.Label%}")))
type Page struct {
	ui.Live
	{%.Service%} *{%.Service%}
{%- if .Auth%}
	me      *auth.Identity
{%- end%}
	rows    []{%.Model%}
	problem string
}

@ui.Mount
func (p *Page) mount(ctx context.Context) error {
{%- if .Auth%}
	p.me = auth.Current(ctx)
{%- end%}
	p.rows = p.{%.Service%}.All(ctx)?
	return nil
}

// Add saves the form's {%.Model%}; an error keeps what was typed.
func (p *Page) Add(ctx context.Context, in New{%.Model%}) error {
	p.problem = ""
	match p.{%.Service%}.Add(ctx, in) {
	case Ok(_):
		p.rows = p.{%.Service%}.All(ctx)?
		return nil
	case Err(e):
		p.problem = e.Error()
		return e
	}
}

// Delete removes the {%.Model%} whose button was clicked (its value is the id).
func (p *Page) Delete(ctx context.Context, id int64) error {
	p.{%.Service%}.Delete(ctx, id)?
	p.rows = p.{%.Service%}.All(ctx)?
	return nil
}
