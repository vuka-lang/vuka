# This machine's settings and secrets. Not committed (.gitignore): copy
# .env.example on another machine. The real environment wins over this file.

APP_NAME={%.Name%}
PORT=8080
{%- if eq .DB "sqlite"%}

# SQLite: a file under data/, made on the first run.
DATABASE_URL=sqlite://data/app.db?_pragma=busy_timeout(5000)&_pragma=journal_mode(WAL)&_pragma=foreign_keys(1)
{%- else if eq .DB "postgres"%}

DATABASE_URL=postgres://postgres:postgres@localhost:5432/{%.Slug%}?sslmode=disable
{%- else if eq .DB "mysql"%}

DATABASE_URL=mysql://root:password@tcp(localhost:3306)/{%.Slug%}
{%- end%}
{%- if .Auth%}

# The first admin, made when the app starts if no user has this email.
# Changing these later changes nothing: sign in and manage users instead.
ADMIN_EMAIL={%.AdminEmail%}
ADMIN_PASSWORD={%.AdminPassword%}
{%- end%}
{%- if .Mail%}

# Mail: log prints messages instead of sending them. In production set
# MAIL_DRIVER=smtp and MAIL_HOST, MAIL_PORT, MAIL_USERNAME, MAIL_PASSWORD.
MAIL_DRIVER=log
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME={%.Name%}
{%- end%}
