// token signs in at POST /auth/token: a bearer token for the API.
func (c *client) token(email, password string) (int, string) {
	c.t.Helper()
	code, body, _ := c.do("POST", "/auth/token", `{"login":"`+email+`","password":"`+password+`"}`, "Content-Type", "application/json")
	var tr struct {
		AccessToken string `json:"access_token"`
	}
	json.Unmarshal([]byte(body), &tr)
	return code, tr.AccessToken
}

func TestAPINeedsAToken(t *testing.T) {
	c := newClient(t, serve(t))
	if code, _, _ := c.do("GET", "/api/users", ""); code != 401 {
		t.Errorf("GET /api/users without a token: %d", code)
	}
	if code, body, _ := c.do("GET", "/", ""); code != 200 || !strings.Contains(body, `"name":"{%.Name%}"`) {
		t.Errorf("GET /: %d %s", code, body)
	}
}

func TestToken(t *testing.T) {
	c := newClient(t, serve(t))

	// A wrong password and an unknown email get the same answer.
	for _, email := range []string{adminEmail, "nobody@example.com"} {
		if code, tok := c.token(email, "not the password"); code != 401 || tok != "" {
			t.Errorf("a wrong login for %s: %d", email, code)
		}
	}
	code, tok := c.token(adminEmail, adminPassword)
	if code != 200 || tok == "" {
		t.Fatalf("a token: %d", code)
	}
	bearer := "Bearer " + tok
	if code, body, _ := c.do("GET", "/api/users", "", "Authorization", bearer); code != 200 || !strings.Contains(body, adminEmail) {
		t.Errorf("GET /api/users: %d %s", code, body)
	}
	code, body, _ := c.do("POST", "/api/users", `{"name":"Grace","email":"grace@example.com","password":"another-password-99"}`, "Authorization", bearer, "Content-Type", "application/json")
	if code != 200 || !strings.Contains(body, `"email":"grace@example.com"`) || strings.Contains(body, "argon2") {
		t.Errorf("POST /api/users: %d %s", code, body)
	}
	if code, tok := c.token("grace@example.com", "another-password-99"); code != 200 || tok == "" {
		t.Errorf("the new user's token: %d", code)
	}
	c.do("POST", "/auth/logout", "", "Authorization", bearer)
	if code, _, _ := c.do("GET", "/api/users", "", "Authorization", bearer); code != 401 {
		t.Errorf("a token after logout: %d", code)
	}
}
