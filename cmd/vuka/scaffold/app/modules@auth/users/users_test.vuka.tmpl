package users

import (
	"errors"
	"testing"

	"github.com/vuka-lang/orm/v2"
	"github.com/vuka-lang/orm/v2/ormtest"
	"github.com/vuka-lang/web/v2/auth"
)

func TestUsers(t *testing.T) {
	ctx := ormtest.Open(t, orm.Objects[User]()) // a fresh SQLite database with the table
	u := &Users{}

	ada, err := u.Create(ctx, NewUser{Name: "Ada", Email: "Ada@Example.com", Password: "correct horse battery"}).Get()
	if err != nil {
		t.Fatal(err)
	}
	if ada.Email != "ada@example.com" || ada.Role != "member" || ada.Password == "correct horse battery" {
		t.Errorf("created: %+v", ada)
	}
	if _, err := u.Create(ctx, NewUser{Name: "Ada again", Email: "ada@example.com", Password: "another password"}).Get(); !errors.Is(err, ErrEmailTaken) {
		t.Errorf("a taken email: %v", err)
	}

	// auth finds her by email, whatever its case, with the stored hash.
	id, encoded, err := u.FindLogin(ctx, " ADA@example.com ")
	if err != nil || id == nil || id.User.(*User).Name != "Ada" {
		t.Fatalf("FindLogin: %v %v", id, err)
	}
	if ok, _, _ := auth.CheckPassword(encoded, "correct horse battery", auth.Argon2Defaults); !ok {
		t.Error("the stored password doesn't check")
	}
	if id, _, _ := u.FindLogin(ctx, "nobody@example.com"); id != nil {
		t.Error("an unknown email found someone")
	}
	if again, err := u.Load(ctx, id.ID); err != nil || again == nil || again.Roles[0] != "member" {
		t.Errorf("Load: %v %v", again, err)
	}
}
