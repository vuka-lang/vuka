# The settings the app reads, with placeholders: copy to .env and fill in.
# In production, set real environment variables instead.

APP_NAME=
PORT=
{%- if eq .DB "sqlite"%}
DATABASE_URL=
{%- else if eq .DB "postgres"%}
DATABASE_URL=
{%- else if eq .DB "mysql"%}
DATABASE_URL=
{%- end%}
{%- if .Auth%}

# The first admin, made at start-up when no user has this email.
ADMIN_EMAIL=
ADMIN_PASSWORD=
{%- end%}
{%- if .Mail%}

MAIL_DRIVER=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM=
MAIL_FROM_NAME=
{%- end%}

