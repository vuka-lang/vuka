<script setup>
{%- if .Auth%}
import { onMounted, ref } from 'vue'
{%- end%}
import logo from '/logo.svg'

// APP_NAME comes from the app's environment (web.FrontendEnv).
const name = import.meta.env.APP_NAME
{%- if .Auth%}
const me = ref()
onMounted(async () => {
  try {
    const r = await fetch('/auth/me')
    me.value = r.ok ? await r.json() : null
  } catch {
    me.value = null
  }
})
{%- end%}
</script>

<template>
  <main class="card">
    <img :src="logo" alt="" />
    <h1>{{ name }}</h1>
    <p>A Vue app, built by Vite and served by the app at <code>/app</code>.</p>
{%- if .Auth%}
    <p v-if="me">Signed in as {{ me.user?.name ?? me.id }}. <a href="/">Back to the app</a></p>
    <p v-else-if="me === null"><a href="/login?next=/app/">Sign in</a> to see who you are.</p>
{%- else%}
    <p><a href="/">Back to the app</a></p>
{%- end%}
  </main>
</template>
