package login

import (
	"context"

	"github.com/vuka-lang/ui/v2"
	"github.com/vuka-lang/web/v2"
	"github.com/vuka-lang/web/v2/auth"

	"{%.Module%}/components"
	"{%.Module%}/layouts"
)

// Index is the sign-in page every other page sends visitors to, /login.
// The form posts to auth's endpoint, POST /auth/login, which signs in and
// goes on to next, or comes back here with ?error=. Its guard sends those
// signed in already on.
@auth.Public
type Index struct {
	Error string
	Next  string
}

func (p Index) Title() string { return "Sign in" }

// message is the error of the last try.
func (p Index) message(ctx context.Context) string {
	if p.Error == "invalid" {
		return "That email and password don't match an account."
	}
	return auth.LoginError(web.Request(ctx))
}
<layouts.Auth title="Sign in to your account" subtitle={"Welcome back to " + layouts.AppName() + "."}>
  <form method="post" action="/auth/login" class="space-y-5" id="login-form">
    <components.Flash tone="error" message={p.message(ctx)} />
    if auth.SafeNext(Next) {
      <input type="hidden" name="next" value={Next} />
    }
    <components.Field label="Email address" name="login">
      <components.Input name="login" type="email" autocomplete="username" placeholder="you@example.com" required autofocus invalid={p.message(ctx) != ""} attrs={[]ui.Attr{{Name: "data-keep", Value: true}}} />
    </components.Field>
    <components.Field label="Password" name="password">
      <components.Input name="password" type="password" autocomplete="current-password" required invalid={p.message(ctx) != ""} />
    </components.Field>
    <label class="flex items-center gap-2.5 text-sm text-slate-600 dark:text-slate-300">
      <input type="checkbox" name="remember" value="1" class="size-4 rounded border-slate-300 text-brand-600 accent-brand-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600 dark:border-white/20" />
      Remember me for two weeks
    </label>
    <components.Button class="w-full">Sign in</components.Button>
  </form>
</layouts.Auth>
