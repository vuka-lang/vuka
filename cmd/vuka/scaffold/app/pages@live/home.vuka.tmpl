// Package pages is the app's own pages: the dashboard and the sign-in
// page. A module's pages live in the module (modules/<name>/pages.vuka).
package pages

import (
{%- if .Auth%}
	"context"
	"strings"
{%- end%}

	"github.com/vuka-lang/ui"
	"github.com/vuka-lang/web"
{%- if .Auth%}
	"github.com/vuka-lang/web/auth"
{%- end%}

	"{%.Module%}/components"
	"{%.Module%}/layouts"
{%- if .Auth%}
	"{%.Module%}/modules/users"
{%- end%}
)

{%- if .Auth%}
// Dashboard is the signed-in home page. It is live (a stateful
// component), so the shell's links move between pages over its
// connection.
@web.Live("/", web.Layout(layouts.Page("Dashboard")))
type Dashboard struct {
	ui.Live
	Users    *users.Users
	me       *auth.Identity
	people   int64
	sessions int64
}

func (d *Dashboard) Mount(ctx context.Context) error {
	d.me = auth.Current(ctx)
	d.people = d.Users.Count(ctx)?
	d.sessions = d.Users.ActiveSessions(ctx)?
	return nil
}

func (d *Dashboard) Render() ui.Node {
	name := "there"
	if u, ok := d.me.User.(*users.User); ok {
		name = strings.Fields(u.Name + " x")[0]
	}
	return <layouts.App me={d.me} path="/" title={"Welcome back, " + name} description={"Here is what's happening in " + layouts.AppName() + "."}>
		<div class="grid gap-4 sm:grid-cols-3">
			<Stat label="Users" value={d.people} href="/users" icon="users" />
			<Stat label="Active sessions" value={d.sessions} href="" icon="sparkles" />
			<Stat label="Your role" value={strings.Join(d.me.Roles, ", ")} href="" icon="info" />
		</div>
{%- else%}
// Home is the home page. It is live (a stateful component), so the
// shell's links move between pages over its connection.
@web.Live("/", web.Layout(layouts.Page("Home")))
type Home struct {
	ui.Live
}

func (h *Home) Render() ui.Node {
	return <layouts.App path="/" title={"Welcome to " + layouts.AppName()} description="Your app is running. Here is where it goes next.">
{%- end%}
		<div class="mt-8 grid gap-4 lg:grid-cols-3">
			<components.Card title="Grow your app" description="Everything here is yours to change. A module is the unit of growth." class="lg:col-span-2">
				<ol class="space-y-4 text-sm">
{%- if ne .DB "none"%}
					<Step n={1} title="Add a module">
						<code class="rounded bg-slate-100 px-1.5 py-0.5 font-mono text-xs text-slate-800 dark:bg-white/10 dark:text-slate-200">vuka add module notes</code>
						{" "}adds a model, a service, a page, a migration and a test under <code class="font-mono text-xs">modules/notes</code>, and links it here.
					</Step>
					<Step n={2} title="Change the schema">
						Edit a model, then <code class="rounded bg-slate-100 px-1.5 py-0.5 font-mono text-xs text-slate-800 dark:bg-white/10 dark:text-slate-200">go tool orm makemigrations</code>; the app applies new migrations when it starts.
					</Step>
{%- else%}
					<Step n={1} title="Add a page">
						A <code class="font-mono text-xs">@web.Live</code> type in <code class="font-mono text-xs">pages/</code> is a page; <code class="font-mono text-xs">layouts.Nav</code> links it here.
					</Step>
					<Step n={2} title="Keep data">
						Start again with <code class="rounded bg-slate-100 px-1.5 py-0.5 font-mono text-xs text-slate-800 dark:bg-white/10 dark:text-slate-200">vuka new --db=sqlite</code> for a database, migrations and modules.
					</Step>
{%- end%}
					<Step n={3} title="Make it look like yours">
						The brand colour and fonts are tokens in <code class="font-mono text-xs">styles/app.css</code>; shared pieces are in <code class="font-mono text-xs">components/</code>.
					</Step>
				</ol>
			</components.Card>
			<components.Card title="Resources" description="">
				<ul class="space-y-3 text-sm">
					<li><a class="font-medium text-brand-700 hover:underline dark:text-brand-400" href="https://vuka-lang.github.io/web/">The web guide</a></li>
					<li><a class="font-medium text-brand-700 hover:underline dark:text-brand-400" href="https://vuka-lang.github.io/ui/">Components and live pages</a></li>
					<li><a class="font-medium text-brand-700 hover:underline dark:text-brand-400" href="https://vuka-lang.github.io/orm/">The ORM</a></li>
				</ul>
			</components.Card>
		</div>
	</layouts.App>
}

// Stat is a number on the dashboard, a link when href is set.
func Stat(label string, value any, href string, icon string) ui.Node {
	body := <div class="flex items-center gap-4">
		<span class="grid size-11 place-items-center rounded-xl bg-brand-50 text-brand-700 dark:bg-brand-500/10 dark:text-brand-400">
			<components.Icon name={icon} class="size-5" />
		</span>
		<div>
			<p class="text-sm text-slate-500 dark:text-slate-400">{label}</p>
			<p class="text-2xl font-semibold tracking-tight text-slate-900 capitalize dark:text-white">{value}</p>
		</div>
	</div>
	class := "block rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-900/5 dark:bg-slate-900 dark:ring-white/10"
	if href == "" {
		return <div class={class}>{body}</div>
	}
	return <ui.Link href={href} class={class + " transition hover:ring-brand-500/40 focus-visible:outline-2 focus-visible:outline-brand-500"}>{body}</ui.Link>
}

// Step is one of the dashboard's next steps.
func Step(n int, title string, children ui.Node) ui.Node {
	return <li class="flex gap-3">
		<span class="grid size-6 shrink-0 place-items-center rounded-full bg-slate-900 text-xs font-semibold text-white dark:bg-white dark:text-slate-900">{n}</span>
		<div>
			<p class="font-medium text-slate-900 dark:text-white">{title}</p>
			<p class="mt-0.5 text-slate-600 dark:text-slate-400">{children}</p>
		</div>
	</li>
}
