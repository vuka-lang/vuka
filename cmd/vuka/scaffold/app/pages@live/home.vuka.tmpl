// Package pages is the app's own pages: the dashboard and the sign-in
// page. A module's pages live in the module (modules/<name>/pages.vuka).
package pages

import (
{%- if .Auth%}
	"context"
	"strings"
{%- end%}

	"github.com/vuka-lang/ui"
	"github.com/vuka-lang/web"
{%- if .Auth%}
	"github.com/vuka-lang/web/auth"
{%- end%}

	"{%.Module%}/layouts"
{%- if .Auth%}
	"{%.Module%}/modules/users"
{%- end%}
)

{%- if .Auth%}
// Dashboard is the signed-in home page (home.vuka.html). It is live (a
// stateful component), so the shell's links move between pages over its
// connection.
@web.Live("/", web.Layout(layouts.Page("Dashboard")))
type Dashboard struct {
	ui.Live
	Users    *users.Users
	me       *auth.Identity
	people   int64
	sessions int64
}

@ui.Mount
func (d *Dashboard) mount(ctx context.Context) error {
	d.me = auth.Current(ctx)
	d.people = d.Users.Count(ctx)?
	d.sessions = d.Users.ActiveSessions(ctx)?
	return nil
}

// firstName is what the greeting calls the user.
func (d *Dashboard) firstName() string {
	if u, ok := d.me.User.(*users.User); ok {
		return strings.Fields(u.Name + " x")[0]
	}
	return "there"
}

const statClass = "block rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-900/5 dark:bg-slate-900 dark:ring-white/10"
{%- else%}
// Home is the home page (home.vuka.html). It is live (a stateful
// component), so the shell's links move between pages over its connection.
@web.Live("/", web.Layout(layouts.Page("Home")))
type Home struct {
	ui.Live
}
{%- end%}
