func (p *IslandPage) Render()
<main class="mx-auto max-w-2xl px-4 py-16 sm:px-6 lg:px-8">
  <h1 class="text-2xl font-semibold tracking-tight text-slate-900 dark:text-white">Vue island</h1>
  <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
    A client-hydrated Vue component on a server-rendered page. The button's
    count lives in the browser; the page around it is sent as plain HTML.
  </p>
  <div class="mt-8 rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-900/5 dark:bg-slate-900 dark:ring-white/10">
    {ui.Mount(Counter{Count: 7, Label: "clicks"}, ui.Visible(), ui.Fallback(loading()))}
  </div>
</main>

func loading()
<p class="text-sm text-slate-500 dark:text-slate-400">loading…</p>
