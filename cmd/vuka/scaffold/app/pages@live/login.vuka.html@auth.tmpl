import "github.com/vuka-lang/web/auth"
import "{%.Module%}/components"
import "{%.Module%}/layouts"

// loginPage is the sign-in form, with the error of the last try.
func loginPage(message string, next string)
<layouts.Auth title="Sign in to your account" subtitle={"Welcome back to " + layouts.AppName() + "."}>
  <form method="post" action="/auth/login" class="space-y-5" id="login-form">
    <components.Flash tone="error" message={message} />
    if auth.SafeNext(next) {
      <input type="hidden" name="next" value={next} />
    }
    <components.Field label="Email address" name="login">
      <components.Input name="login" type="email" autocomplete="username" placeholder="you@example.com" required autofocus invalid={message != ""} attrs={[]ui.Attr{{Name: "data-keep", Value: true}}} />
    </components.Field>
    <components.Field label="Password" name="password">
      <components.Input name="password" type="password" autocomplete="current-password" required invalid={message != ""} />
    </components.Field>
    <label class="flex items-center gap-2.5 text-sm text-slate-600 dark:text-slate-300">
      <input type="checkbox" name="remember" value="1" class="size-4 rounded border-slate-300 text-brand-600 accent-brand-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600 dark:border-white/20" />
      Remember me for two weeks
    </label>
    <components.Button class="w-full">Sign in</components.Button>
  </form>
</layouts.Auth>
