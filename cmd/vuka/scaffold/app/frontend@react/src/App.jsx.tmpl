{%- if .Auth%}
import { useEffect, useState } from 'react'
{%- end%}
import logo from '/logo.svg'

// APP_NAME comes from the app's environment (web.FrontendEnv).
const name = import.meta.env.APP_NAME
{%- if .Auth%}

export default function App() {
  const [me, setMe] = useState()
  useEffect(() => {
    fetch('/auth/me')
      .then((r) => (r.ok ? r.json() : null))
      .then(setMe, () => setMe(null))
  }, [])
  return (
    <main className="card">
      <img src={logo} alt="" />
      <h1>{name}</h1>
      <p>A React app, built by Vite and served by the app at <code>/app</code>.</p>
      {me === undefined ? null : me ? (
        <p>Signed in as {me.user?.name ?? me.id}. <a href="/">Back to the app</a></p>
      ) : (
        <p><a href="/login?next=/app/">Sign in</a> to see who you are.</p>
      )}
    </main>
  )
}
{%- else%}

export default function App() {
  return (
    <main className="card">
      <img src={logo} alt="" />
      <h1>{name}</h1>
      <p>A React app, built by Vite and served by the app at <code>/app</code>.</p>
      <p><a href="/">Back to the app</a></p>
    </main>
  )
}
{%- end%}
