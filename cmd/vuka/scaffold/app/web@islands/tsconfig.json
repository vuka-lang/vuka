{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "skipLibCheck": true,
    "paths": { "vuka:live": ["./vuka-live"], "vuka:island": ["./vuka-island"] }
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.vue", "*.d.ts"]
}
