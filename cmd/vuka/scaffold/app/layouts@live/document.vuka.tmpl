// Package layouts is the app's page frames: the document every page sits
// in, the signed-in shell (app.vuka) and the centred card of the sign-in
// pages (auth.vuka).
package layouts

import (
	"github.com/vuka-lang/ui"
	"github.com/vuka-lang/web"
)

// AppName is the app's name, as pages and the shell show it (APP_NAME).
func AppName() string { return web.Env("APP_NAME", "{%.Name%}") }

// Document is the HTML document around a page. The Tailwind stylesheet
// (styles/app.css) is linked by the framework.
func Document(title string, children ui.Node) ui.Node {
	full := AppName()
	if title != "" {
		full = title + " · " + full
	}
	return <html lang="en" class="h-full bg-slate-50 antialiased dark:bg-slate-950">
		<head>
			<meta charset="utf-8" />
			<meta name="viewport" content="width=device-width, initial-scale=1" />
			<meta name="color-scheme" content="light dark" />
			<title>{full}</title>
			<link rel="icon" type="image/svg+xml" href="/static/logo.svg" />
			<script>{ui.Safe(busyForms)}</script>
		</head>
		<body class="h-full font-sans text-slate-900 dark:text-slate-100">{children}</body>
	</html>
}

// Page is the layout of a live page titled title (web.Layout).
func Page(title string) func(page ui.Node) ui.Node {
	return func(page ui.Node) ui.Node { return <Document title={title}>{page}</Document> }
}

// busyForms marks a plain form's submit button aria-busy while the browser
// posts it, so it shows its spinner (a page restored from the back-forward
// cache clears it), and keeps the fields marked data-keep for this tab, so a
// form that comes back with an error still has them.
const busyForms = `addEventListener("submit", (e) => {
  if (e.defaultPrevented) return;
  const b = e.submitter || e.target.querySelector("[type=submit]");
  if (b) b.setAttribute("aria-busy", "true");
  e.target.querySelectorAll("[data-keep]").forEach((f) => sessionStorage.setItem("keep:" + f.name, f.value));
});
addEventListener("DOMContentLoaded", () => document.querySelectorAll("[data-keep]").forEach((f) => {
  if (!f.value) f.value = sessionStorage.getItem("keep:" + f.name) || "";
}));
addEventListener("pageshow", () => document.querySelectorAll("[aria-busy=true]").forEach((b) => b.removeAttribute("aria-busy")));`
