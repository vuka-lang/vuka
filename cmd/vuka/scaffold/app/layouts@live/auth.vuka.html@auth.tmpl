// Auth is the frame of the signed-out pages: the logo over a centred card.
func Auth(title string, subtitle string, children ui.Node)
<Document title={title}>
  <div class="relative flex min-h-full flex-col justify-center overflow-hidden px-4 py-12 sm:px-6">
    <div class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-80 bg-gradient-to-b from-brand-100/70 to-transparent dark:from-brand-500/10" aria-hidden="true" />
    <div class="mx-auto w-full max-w-sm">
      <div class="flex flex-col items-center text-center">
        <img src="/static/logo.svg" alt={AppName()} width="56" height="56" class="size-14 rounded-2xl shadow-md ring-1 ring-black/5" />
        <h1 class="mt-6 text-2xl font-semibold tracking-tight text-slate-900 dark:text-white">{title}</h1>
        if subtitle != "" {
          <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">{subtitle}</p>
        }
      </div>
      <div class="mt-8 rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-900/5 sm:p-8 dark:bg-slate-900 dark:ring-white/10">
        {children}
      </div>
      <p class="mt-8 text-center text-xs text-slate-400 dark:text-slate-500">{AppName()} · built with Vuka</p>
    </div>
  </div>
</Document>
