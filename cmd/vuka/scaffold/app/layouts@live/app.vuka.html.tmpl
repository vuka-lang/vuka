<script lang="go">
package layouts

import (
	"github.com/vuka-lang/ui/v2"
{%- if .Auth%}
	"github.com/vuka-lang/web/v2/auth"
{%- end%}

	"{%.Module%}/components"
)

// App is the {%if .Auth%}signed-in {%end%}shell: the top bar with the logo, the navigation
// (Path highlights its link){%if .Auth%} and the user menu{%end%}, then the page's title,
// its actions and the page itself.
type App struct {
{%- if .Auth%}
	Me          *auth.Identity
{%- end%}
	Path        string
	Title       string
	Description string
	Actions     ui.Node
	Children    ui.Node
}
</script>

<div class="min-h-full">
  <header class="sticky top-0 z-30 border-b border-slate-900/10 bg-white/80 backdrop-blur dark:border-white/10 dark:bg-slate-950/80">
    <div class="mx-auto flex h-16 max-w-6xl items-center gap-6 px-4 sm:px-6 lg:px-8">
      <ui.Link href="/" class="rounded-lg focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-500">
        <components.Logo name={AppName()} />
      </ui.Link>
      <NavLinks{%if .Auth%} me={Me}{%end%} path={Path} class="hidden items-center gap-1 md:flex" />
{%- if .Auth%}
      <div class="ml-auto"><UserMenu me={Me} /></div>
{%- end%}
    </div>
    <NavLinks{%if .Auth%} me={Me}{%end%} path={Path} class="flex gap-1 overflow-x-auto border-t border-slate-900/5 px-4 py-2 md:hidden dark:border-white/5" />
  </header>
  <main id="main" class="mx-auto max-w-6xl px-4 py-8 outline-none sm:px-6 lg:px-8">
    <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
      <div>
        <h1 class="text-2xl font-semibold tracking-tight text-slate-900 dark:text-white">{Title}</h1>
        if Description != "" {
          <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">{Description}</p>
        }
      </div>
      {Actions}
    </div>
    {Children}
  </main>
</div>
