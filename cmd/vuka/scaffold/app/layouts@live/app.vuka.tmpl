package layouts

import (
	"strings"

	"github.com/vuka-lang/ui"
{%- if .Auth%}
	"github.com/vuka-lang/web/auth"
{%- end%}
)

{%- if .Auth%}
// Account is what the shell shows of the signed-in user; the users
// module's User has it.
type Account interface {
	DisplayName() string
	EmailAddress() string
}

func accountName(me *auth.Identity) string {
	if me == nil {
		return ""
	}
	if a, ok := me.User.(Account); ok {
		return a.DisplayName()
	}
	return me.ID
}

func accountEmail(me *auth.Identity) string {
	if me == nil {
		return ""
	}
	if a, ok := me.User.(Account); ok {
		return a.EmailAddress()
	}
	return ""
}

func initials(name string) string {
	var out []rune
	for _, w := range strings.Fields(name) {
		out = append(out, []rune(strings.ToUpper(w))[0])
		if len(out) == 2 {
			break
		}
	}
	if len(out) == 0 {
		return "?"
	}
	return string(out)
}
{%- end%}

// active reports whether the page at path belongs to the link href.
func active(path, href string) bool {
	if href == "/" {
		return path == "/"
	}
	return path == href || strings.HasPrefix(path, href+"/")
}

func navClass(on bool) string {
	if on {
		return "inline-flex items-center gap-2 rounded-lg bg-slate-900/5 px-3 py-2 text-sm font-medium text-slate-900 dark:bg-white/10 dark:text-white"
	}
	return "inline-flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-medium text-slate-600 hover:bg-slate-900/5 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-white/5 dark:hover:text-white"
}

func current(on bool) []ui.Attr {
	if on {
		return []ui.Attr{{Name: "aria-current", Value: "page"}}
	}
	return nil
}
{%- if .Auth%}

// The user menu opens and closes in the browser (JS commands): no server
// round trip.
var (
	toggleUserMenu = ui.JS.Toggle(ui.Ref("user-menu"), ui.Transition("transition ease-out duration-100", "opacity-0 scale-95", "opacity-100 scale-100")).
			ToggleAttr(ui.Ref("user-button"), "aria-expanded", "true", "false")
	closeUserMenu = ui.JS.Key("Escape").Hide(ui.Ref("user-menu")).SetAttr(ui.Ref("user-button"), "aria-expanded", "false").Focus(ui.Ref("user-button"))
)
{%- end%}
