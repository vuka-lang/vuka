package components

import "github.com/vuka-lang/ui"

// ButtonProps are a Button's attributes.
type ButtonProps struct {
	Type     string // "submit" (the default in a form), "button"
	Variant  string // "primary" (the default), "secondary", "ghost", "danger"
	Size     string // "md" (the default), "sm"
	Class    string
	OnClick  any       // a handler, or a chain of JS commands (ui.JS…)
	Attrs    []ui.Attr // any other attributes: name, value, disabled, aria-*
	Children ui.Node
}

var buttonVariants = map[string]string{
	"primary":   "bg-brand-600 text-white shadow-sm hover:bg-brand-700 focus-visible:outline-brand-600",
	"secondary": "bg-white text-slate-900 shadow-sm ring-1 ring-inset ring-slate-300 hover:bg-slate-50 dark:bg-white/5 dark:text-white dark:ring-white/15 dark:hover:bg-white/10",
	"ghost":     "text-slate-700 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-white/5",
	"danger":    "bg-red-600 text-white shadow-sm hover:bg-red-500 focus-visible:outline-red-600",
}

// attrs are the button element's attributes.
func (p ButtonProps) attrs() []ui.Attr {
	typ := p.Type
	if typ == "" {
		typ = "submit"
	}
	variant, ok := buttonVariants[p.Variant]
	if !ok {
		variant = buttonVariants["primary"]
	}
	size := "px-3.5 py-2.5 text-sm"
	if p.Size == "sm" {
		size = "px-2.5 py-1.5 text-xs"
	}
	class := cx("group relative inline-flex items-center justify-center gap-2 rounded-lg font-semibold transition",
		"focus-visible:outline-2 focus-visible:outline-offset-2 disabled:cursor-not-allowed disabled:opacity-60",
		"aria-busy:pointer-events-none aria-busy:opacity-80", size, variant, p.Class)
	attrs := append([]ui.Attr{{Name: "type", Value: typ}, {Name: "class", Value: class}}, p.Attrs...)
	if p.OnClick != nil {
		on, ok := p.OnClick.(ui.EventHandler)
		if !ok {
			on = ui.On(p.OnClick)
		}
		attrs = append(attrs, ui.Attr{Name: "onClick", Value: on})
	}
	return attrs
}
