package components

import "github.com/vuka-lang/ui/v2"

// Input is a text field.
type Input struct {
	ID           string
	Name         string
	Type         string // "text" by default
	Value        string
	Placeholder  string
	Autocomplete string
	Required     bool
	Autofocus    bool
	Invalid      bool // shown in red, aria-invalid
	Class        string
	Attrs        []ui.Attr
}

// attrs are the input element's attributes.
func (in Input) attrs() []ui.Attr {
	typ := in.Type
	if typ == "" {
		typ = "text"
	}
	id := in.ID
	if id == "" {
		id = in.Name
	}
	ring := "ring-slate-300 focus:ring-brand-600 dark:ring-white/15 dark:focus:ring-brand-400"
	if in.Invalid {
		ring = "ring-red-400 focus:ring-red-500 dark:ring-red-500/60"
	}
	class := cx("block w-full rounded-lg border-0 bg-white px-3 py-2.5 text-sm text-slate-900 shadow-sm ring-1 ring-inset placeholder:text-slate-400",
		"focus:outline-none focus:ring-2 focus:ring-inset dark:bg-white/5 dark:text-white dark:placeholder:text-slate-500", ring, in.Class)
	attrs := []ui.Attr{{Name: "id", Value: id}, {Name: "name", Value: in.Name}, {Name: "type", Value: typ}, {Name: "class", Value: class},
		{Name: "value", Value: in.Value}, {Name: "placeholder", Value: in.Placeholder}, {Name: "autocomplete", Value: in.Autocomplete},
		{Name: "required", Value: in.Required}, {Name: "autofocus", Value: in.Autofocus}, {Name: "aria-invalid", Value: in.Invalid}}
	return append(attrs, in.Attrs...)
}
<input {in.attrs()...} />
