package components

// Card is a panel with an optional title and description.
func Card(title string, description string, class string, children ui.Node)
<section class={cx("rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-900/5 dark:bg-slate-900 dark:ring-white/10", class)}>
  if title != "" {
    <header class="mb-4">
      <h2 class="text-base font-semibold text-slate-900 dark:text-white">{title}</h2>
      if description != "" {
        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">{description}</p>
      }
    </header>
  }
  {children}
</section>
