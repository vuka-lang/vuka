# The settings the app reads, with placeholders: copy to .env and fill in.
# In production, set real environment variables instead.

APP_NAME={%.Name%}
PORT=8080
{%- if eq .DB "sqlite"%}
DATABASE_URL=sqlite://data/app.db?_pragma=busy_timeout(5000)&_pragma=journal_mode(WAL)&_pragma=foreign_keys(1)
{%- else if eq .DB "postgres"%}
DATABASE_URL=postgres://user:password@localhost:5432/{%.Slug%}?sslmode=disable
{%- else if eq .DB "mysql"%}
DATABASE_URL=mysql://user:password@tcp(localhost:3306)/{%.Slug%}
{%- end%}
{%- if .Auth%}

# The first admin, made at start-up when no user has this email.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-12-characters-or-more
{%- end%}
{%- if .Mail%}

MAIL_DRIVER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=starttls
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME={%.Name%}
{%- end%}
