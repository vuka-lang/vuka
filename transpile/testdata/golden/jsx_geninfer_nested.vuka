package main

import (
	"context"
	"fmt"

	"github.com/vuka-lang/ui/v2"
)

type Order struct {
	Number string
	Total  int
}

type TableData[T any] struct {
	Rows  []T
	Count int
}

// DataTable's T comes from its data, a TableData[T]; its row slot's value
// is that T.
type DataTable[T any] struct {
	Data TableData[T]
	Row  func(T) ui.Node
}

func (d DataTable[T]) Render() ui.Node {
	return <table data-count={d.Data.Count}>{for _, r := range d.Data.Rows { <tr>{d.Row(r)}</tr> }}</table>
}

// Index's K and V come through a pointer to a map of slices.
type Index[K comparable, V any] struct {
	By   *map[K][]V
	Show func(K, V) string
}

func (x Index[K, V]) Render() ui.Node {
	return <ul>{for k, vs := range *x.By { {for _, v := range vs { <li>{x.Show(k, v)}</li> }} }}</ul>
}

// Pair's T is float64: a typed float64 and an untyped 1, as Go infers it.
type Pair[T any] struct {
	A T
	B T
}

func (p Pair[T]) Render() ui.Node { return <b>{fmt.Sprint(p.A, "+", p.B)}</b> }

func page(orders TableData[Order], by map[string][]int, x float64) ui.Node {
	return <main>
		<DataTable data={orders}>
			<slot:row let={o}><td>{o.Number}</td><td>{o.Total}</td></slot:row>
		</DataTable>
		<Index by={&by} show={func(k string, v int) string { return fmt.Sprint(k, v) }} />
		<Pair a={x} b={1} />
		<Pair a={1} b={2.5} />
		<Pair[float64] a={1} b={2} />
	</main>
}

func main() {
	orders := TableData[Order]{Rows: []Order{{"A-1", 30}, {"A-2", 12}}, Count: 2}
	fmt.Println(ui.String(context.Background(), page(orders, map[string][]int{"k": {1, 2}}, 0.5)))
}
