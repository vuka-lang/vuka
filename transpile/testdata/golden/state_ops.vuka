package main

import ui "vukatest.local/stateui"

type Range struct{ Lo, Hi int }

type Query struct {
	Text  string
	Range Range
}

const Max = 10

func Ops(min int) ui.Node {
	n := ui.State(1)
	q := ui.State(Query{})
	x := ui.State[float64](0.5)
	// one dep per state however often it is read; server values as deps
	return <p
		a={n < Max}
		b={n <= min && n >= 0 || n > q.Range.Hi}
		c={n != n-1 && x > 0.25}
		d={+n}
		e={q.Range.Lo == 0}
	>
		{q.Text + " " + "items"}
		{"about " + q.Text}
	</p>
}

func main() {}

// Outside JSX a struct state's fields are states of their own.
func narrow(q ui.State[Query]) ui.Commands {
	return ui.JS.Set(q.Text, "dog").Set(q.Range.Lo, 2)
}

func reset(q ui.State[Query]) ui.Commands { return ui.JS.Set(q.Range.Hi, 0) }
