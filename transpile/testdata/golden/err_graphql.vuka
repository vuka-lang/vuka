package main

import (
	"context"

	"github.com/vuka-lang/web/v2/graphql"
)

type User struct {
	Name string
	Meta map[string]string
}

@graphql.Type("User")
type Person struct{ Name string }

type Board struct{}

@graphql.Query
func Users(ctx context.Context) ([]User, error) { return nil, nil }

@graphql.Query("users")
func People(ctx context.Context) ([]Person, error) { return nil, nil }

@graphql.Query("__secret")
func Secret() string { return "" }

@graphql.Mutation
func Save(ctx context.Context, names ...string) error { return nil }

@graphql.Query
func (b *Board) Size() int { return 0 }

@graphql.Subscription
func Ticks(ctx context.Context) (<-chan int, error) { return nil, nil }

@graphql.Query
@graphql.AsID("ownr", "weight")
func Heavy(owner int64, weight float64) int { return 0 }

func main() {}
