package main

import "context"

type NoRender struct{ vuka.Live }

type BadRender struct{ vuka.Live }

func (b *BadRender) Render(ctx context.Context) vuka.Node { return nil }

type Ptr struct{ *vuka.Live }

func (p *Ptr) Render() vuka.Node { return nil }

type Named int

type Counter struct {
	vuka.Live
	Start int
	n     int
}

func (c *Counter) Render() vuka.Node { return <b>{c.n}</b> }

type BadMount struct{ vuka.Live }

func (b *BadMount) Mount(n int)       {}
func (b *BadMount) Render() vuka.Node { return nil }

type Box[T any] struct {
	vuka.Live
	Value T
}

func (b *Box[T]) Render() vuka.Node { return nil }

type A struct{ Title string }
type B struct{ Title string }

type Props struct {
	A
	B
}

func Both(p Props) vuka.Node { return nil }

func page() vuka.Node {
	return <>
		<NoRender />
		<BadRender />
		<Ptr />
		<Named />
		<Counter n={1} />
		<Counter Stat={1} />
		<Counter>kids</Counter>
		<BadMount />
		<Box Value={1} />
		<Both Title="x" />
		<button onClick={42}>a</button>
		<button onClick={func(a, b int) {}}>b</button>
		<input onInput={func(x []int) {}} />
		<input onInput={func(s string) int { return 0 }} />
	</>
}

func main() {}
