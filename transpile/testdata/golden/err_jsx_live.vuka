package main

import (
	"context"
	"github.com/vuka-lang/ui"
)

type NoRender struct{ ui.Live }

type BadRender struct{ ui.Live }

func (b *BadRender) Render(ctx context.Context) ui.Node { return nil }

type Ptr struct{ *ui.Live }

func (p *Ptr) Render() ui.Node { return nil }

type Named int

type Counter struct {
	ui.Live
	Start int
	n     int
}

func (c *Counter) Render() ui.Node { return <b>{c.n}</b> }

type BadMount struct{ ui.Live }

func (b *BadMount) Mount(n int)       {}
func (b *BadMount) Render() ui.Node { return nil }

type Box[T any] struct {
	ui.Live
	Value T
}

func (b *Box[T]) Render() ui.Node { return nil }

type A struct{ Title string }
type B struct{ Title string }

type Props struct {
	A
	B
}

func Both(p Props) ui.Node { return nil }

func page() ui.Node {
	return <>
		<NoRender />
		<BadRender />
		<Ptr />
		<Named />
		<Counter n={1} />
		<Counter Stat={1} />
		<Counter>kids</Counter>
		<BadMount />
		<Box Value={1} />
		<Both Title="x" />
		<button onClick={42}>a</button>
		<button onClick={func(a, b int) {}}>b</button>
		<input onInput={func(x []int) {}} />
		<input onInput={func(s string) int { return 0 }} />
		<NotLive />
		<button onClick={"go()"}>c</button>
		<button onClick={nil}>d</button>
	</>
}

func main() {}

type NotLive struct{ Start int }

func (n *NotLive) Render() ui.Node { return nil }
