<form data-for="{Join.Form}" data-key="7"><label for="id:Signup.Email">Email</label><label for="id:Join.for_">Plain</label><input data-model="Signup.Email tag=input mods=lazy own=class" class="input"><p>field {Signup.Bio} Bio</p><textarea data-model="Signup.Bio tag=textarea mods=raw">hi</textarea><select data-model="Signup.Plan tag=select"><option value="a">choices of Signup.Plan</option></select><select data-model="Signup.Size tag=select"><option value="s">Small</option><option value="l" selected>Large</option></select><input type="radio" data-model="Signup.Plan tag=input type=radio value=pro own=type+value" value="pro"></form> <nil>
