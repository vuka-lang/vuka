package main

import "golden/fttarget"

type Row struct {
	ID   int
	Name string
	Done bool
}

// List exercises the FT (lazy-frame) lowering: static and dynamic attributes, a
// text hole, a loop body, a fragment and a nested frame.
func List(title string, rows []Row) fttarget.Node {
	return <div className="list">
		<h1>{title}</h1>
		<ul>
			{for _, r := range rows {
				<li className={"row row-" + r.Name} data-done={r.Done}>
					<a href={"/row/" + r.Name}>{r.Name}</a>
					<>{r.ID}</>
				</li>
			}}
		</ul>
	</div>
}
