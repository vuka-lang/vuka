package main

import "github.com/vuka-lang/ui"

type TableProps[T any] struct{ Rows []T }

func Table[T any](props TableProps[T]) ui.Node { return <table>{len(props.Rows)}</table> }

func Empty[T any]() ui.Node { return <p/> }

func Box[T any](value T) ui.Node { return <p>{value}</p> }

func Price(amount int) ui.Node     { return <b>{amount}</b> }
func Price(amount float64) ui.Node { return <b>{amount}</b> }
func Price(amount int, children ui.Node) ui.Node {
	return <b>{amount}{children}</b>
}

func Num(n int64) ui.Node { return <i>{n}</i> }
func Num(n int32) ui.Node { return <i>{n}</i> }

func page() ui.Node {
	return <>
		<Table rows={[]int{1}} />
		<Empty />
		<Box />
		<Price amount="x" />
		<Price cost={1} />
		<Num n={1} />
		<Price amount={1}>kids</Price>
	</>
}

func main() {}
