package main

type TableProps[T any] struct{ Rows []T }

func Table[T any](props TableProps[T]) vuka.Node { return <table>{len(props.Rows)}</table> }

func Empty[T any]() vuka.Node { return <p/> }

func Box[T any](value T) vuka.Node { return <p>{value}</p> }

func Price(amount int) vuka.Node     { return <b>{amount}</b> }
func Price(amount float64) vuka.Node { return <b>{amount}</b> }
func Price(amount int, children vuka.Node) vuka.Node {
	return <b>{amount}{children}</b>
}

func Num(n int64) vuka.Node { return <i>{n}</i> }
func Num(n int32) vuka.Node { return <i>{n}</i> }

func page() vuka.Node {
	return <>
		<Table rows={[]int{1}} />
		<Empty />
		<Box />
		<Price amount="x" />
		<Price cost={1} />
		<Num n={1} />
		<Price amount={1}>kids</Price>
	</>
}

func main() {}
