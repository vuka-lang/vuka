package main

import (
	"strings"

	ui "vukatest.local/stateui"
)

func Bad() ui.Node {
	open := ui.State(false)
	tab := ui.State("logs")
	n := ui.State(2)
	return <div>
		<p title={strings.ToUpper(tab)} />
		<p data-n={n * 2} />
		<button onClick={open.Inc()} />
		<button onClick={tab.Toggle()} />
		<button onClick={ui.JS.Set(tab, 3)} />
		<Label text={!open} />
		<Any v={strings.ToUpper(tab)} />
		<p>{strings.Repeat(tab, 2)}</p>
		<Any v={describe(open)} />
	</div>
}

func Any(v any) ui.Node { return <i>{v}</i> }

func describe(open ui.State[bool]) string { return "" }

func Label(text bool) ui.Node { return <span>{text}</span> }
