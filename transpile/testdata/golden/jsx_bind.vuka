package main

import (
	"context"
	"fmt"

	"github.com/vuka-lang/ui/v2"
)

// Search binds its query to its input and sets a CSS variable.
type Search struct {
	ui.Live
	Q     string @ui.Bind
	Color string
}

func (s *Search) Render() ui.Node {
	return <form style:--accent={s.Color}>
		<input bind:value={s.Q} />
	</form>
}

func main() {
	out, err := ui.String(context.Background(), ui.Component("s", nil, &Search{Q: "go", Color: "red"}))
	fmt.Println(out, err)
}
