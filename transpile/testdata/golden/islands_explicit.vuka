package main

import (
	"context"
	"fmt"

	Picker "./islands/Picker.vue"
	ui "vukatest.local/islandui"
)

// The @ui.Island struct wins over the props read from Picker.vue: the
// import only names it, and a bare tag mounts it.
@ui.Island("islands/Picker.vue")
type Picker struct {
	Weeks int `json:"weeks"`
}

func main() {
	s, err := ui.String(context.Background(), <Picker weeks={2} client:load />)
	if err != nil {
		panic(err)
	}
	fmt.Println(s)
}
