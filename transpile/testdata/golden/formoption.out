<div><form data-for="{Edit.Form}" data-key="&lt;nil&gt;" data-bound="Name,Notes"><label for="id:FormFor[main.Product].Value">Name</label><input data-model="FormFor[main.Product].Value tag=input"><input data-model="? tag=input mods=lazy"><textarea data-model="? tag=textarea">None</textarea><p>field {?} </p></form><form data-for="{Edit.Order}" data-key="&lt;nil&gt;"><label for="id:Order.Note">Note</label><input data-model="Order.Note tag=input"><select data-model="Order.Ref tag=select"><option value="a">choices of Order.Ref</option></select></form><form data-for="{Edit.Model}" data-key="&lt;nil&gt;"><input data-model="Product.Name tag=input"></form></div> <nil>
