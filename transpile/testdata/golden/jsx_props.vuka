package main

import (
	"context"
	"fmt"

	"github.com/vuka-lang/vuka/live"
)

// JSX outside function bodies.
var header = <h1>Pets</h1>

var (
	footer = <footer>{year()}</footer>
	links  = map[string]vuka.Node{"home": <a href="/">home</a>}
)

type Shell struct{ Body vuka.Node }

var shell = Shell{Body: <p>body</p>}

func year() int { return 2026 }

type Base struct {
	ID    int
	Class string
}

type Sized struct{ Width, Height int }

// CardProps binds the fields promoted from Base and *Sized.
type CardProps struct {
	Base
	*Sized
	Title    string
	Children vuka.Node
}

func Card(p CardProps) vuka.Node {
	return <div id={p.ID} className={p.Class}>{p.Title} {p.Width}x{p.Height}{p.Children}</div>
}

type Chat struct {
	vuka.Live
	Base
	Room string
	log  []string
}

type NewMessage struct{ Text string }

type Typing struct{ Who string }

func (c *Chat) Mount() { c.Subscribe("room:" + c.Room) }

func (c *Chat) Update(m NewMessage)                   { c.log = append(c.log, "says "+m.Text) }
func (c *Chat) Update(ctx context.Context, t Typing) { c.log = append(c.log, t.Who+" is typing") }

func (c *Chat) Render() vuka.Node {
	return <ul className={c.Class}>{for _, l := range c.log { <li>{l}</li> }}</ul>
}

type Box[T any] struct {
	vuka.Live
	Value T
}

func (b *Box[T]) Render() vuka.Node { return <b>{b.Value}</b> }

func page(ctx context.Context) vuka.Node {
	w := 3
	return <>
		{header}
		<Card Title="a" Class="c" Width={w} ID={1}>!</Card>
		<Card Width={w} Title="b" Height={4} />
		<Chat Room="go" Class="chat" />
		<Chat ID={2} key={"rust"} Room="rust" />
		<Box[int] Value={7} />
		{footer}{links["home"]}{shell.Body}
	</>
}

func main() {
	ctx := context.Background()
	s, err := vuka.String(ctx, page(ctx))
	fmt.Println(s, err)
	sess := live.NewSession(ctx, page)
	sess.Render()
	fmt.Println(sess.Topics())
	for _, msg := range []any{NewMessage{"hi"}, Typing{"ann"}, 42} {
		p, err := sess.Info("room:go", msg)
		fmt.Println(p.Updates, err)
	}
}
