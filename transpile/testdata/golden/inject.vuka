package main

import (
	"fmt"
	"reflect"
	"strings"
	"sync"
)

// A tiny container: constructors by result type, each built once.
var (
	providers = map[reflect.Type]reflect.Value{}
	built     = map[reflect.Type]reflect.Value{}
	injected  = map[string]string{}
)

func provide(ctor any) {
	f := reflect.ValueOf(ctor)
	providers[f.Type().Out(0)] = f
}

func resolve(t reflect.Type) reflect.Value {
	if v, ok := built[t]; ok {
		return v
	}
	f, ok := providers[t]
	if !ok {
		panic("no provider for " + t.String())
	}
	var args []reflect.Value
	for i := 0; i < f.Type().NumIn(); i++ {
		args = append(args, resolve(f.Type().In(i)))
	}
	v := f.Call(args)[0]
	built[t] = v
	return v
}

func get[T any]() T { return resolve(reflect.TypeOf((*T)(nil)).Elem()).Interface().(T) }

// component is the whole DI integration: register the type's constructor.
func component(t *vuka.Type) {
	provide(t.New)
	var names []string
	for _, f := range t.Fields {
		if f.Injected {
			names = append(names, f.Name)
		}
	}
	injected[t.Name] = strings.Join(names, ",")
}

type DB struct{ name string }

type Mailer interface{ Send(to string) string }

type smtp struct{}

func (smtp) Send(to string) string { return "mail to " + to }

@component
type UserService struct {
	db     *DB
	mailer Mailer
	sent   int `inject:"-"`
}

@component
type OrderService struct {
	*UserService
	db *DB
	mu sync.Mutex `inject:"-"`
}

// Audit declares its own constructor; that is the one registered.
@component
type Audit struct{ prefix string }

func Audit.New(db *DB) *Audit { return &Audit{prefix: "audit:" + db.name} }

func main() {
	provide(func() *DB { return &DB{name: "main"} })
	provide(func() Mailer { return smtp{} })

	o := get[*OrderService]()
	fmt.Println(o.mailer.Send("ada"), o.db == o.UserService.db, o.db.name)
	fmt.Println(get[*Audit]().prefix)
	fmt.Println(injected["main.UserService"], "|", injected["main.OrderService"], "|", injected["main.Audit"])

	u := UserService.New(&DB{name: "test"}, smtp{}) // the generated static New, for tests
	fmt.Println(u.db.name, u.sent)
}
