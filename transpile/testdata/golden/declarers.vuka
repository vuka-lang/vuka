package main

import (
	"fmt"
	"reflect"
	"sort"
	"strings"
)

// A tiny route registry: declarers record routes at start-up, and serve calls
// a handler with its parameters bound by name.
type route struct {
	method, path string
	decl         *vuka.Decl
}

var routes []route

func Get(path string) func(*vuka.Decl) {
	return func(d *vuka.Decl) { routes = append(routes, route{"GET", path, d}) }
}

// Route is an attribute read by the plain declarer below.
type Route struct{ Method, Path string }

func routed(d *vuka.Decl) {
	var r Route
	if d.Attr(&r) {
		routes = append(routes, route{r.Method, r.Path, d})
	}
}

var (
	order []string
	decls = map[string]*vuka.Decl{}
)

func trace(d *vuka.Decl) { order, decls[d.Name] = append(order, d.Name), d }

func serve(method, path string, params map[string]string, recv any) {
	for _, r := range routes {
		if r.method != method || r.path != path {
			continue
		}
		var args []reflect.Value
		if r.decl.Recv != nil {
			args = append(args, reflect.ValueOf(recv))
		}
		for _, p := range r.decl.Params {
			args = append(args, reflect.ValueOf(params[p.Name]).Convert(p.Type))
		}
		for _, out := range reflect.ValueOf(r.decl.Func).Call(args) {
			fmt.Println(method, path, "->", out.Interface())
		}
	}
}

decorator logged(c) {
	fmt.Println("call", c.Name, c.Args)
	c.Next()
}

func shout(f func(string) string) func(string) string {
	return func(s string) string { return strings.ToUpper(f(s)) }
}

@trace
@Get("/pets/{id}")
@logged
func showPet(id string, verbose string) string { return "pet " + id + " " + verbose }

@Get("/hello")
@shout
func hello(name string) string { return "hello " + name }

@Route{Method: "POST", Path: "/pets"}
@routed
@trace
func addPet(name string, _ string) string { return "added " + name }

type PetAdmin struct{ prefix string }

@Get("/admin")
@trace
func (a *PetAdmin) Index(user string) string { return a.prefix + user }

@trace
func describe(id int, tags ...string) (string, error) { return "", nil }

func main() {
	fmt.Println(order)
	serve("GET", "/pets/{id}", map[string]string{"id": "7", "verbose": "yes"}, nil)
	serve("GET", "/hello", map[string]string{"name": "ada"}, nil)
	serve("POST", "/pets", map[string]string{"name": "rex"}, nil)
	serve("GET", "/admin", map[string]string{"user": "bob"}, &PetAdmin{prefix: "admin:"})
	fmt.Println(showPet("1", "no"))
	var lines []string
	for _, r := range routes {
		d := r.decl
		lines = append(lines, fmt.Sprintf("%s %s %s %s:%d recv=%v params=%v results=%v", r.method, r.path, d.Name, d.File, d.Line, d.Recv, d.Params, d.Results))
	}
	sort.Strings(lines)
	fmt.Println(strings.Join(lines, "\n"))
	d := decls["main.describe"]
	fmt.Println(d.Pkg, d.Variadic, d.Params, d.Results)
}
