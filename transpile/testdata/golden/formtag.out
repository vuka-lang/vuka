<main><div data-element class="space-y-4" data-validate="submit" data-keep><form data-for="{Checkout.Form}" data-key="3"><label for="id:Order.Name">label of Order.Name</label><label for="id:Order.Name">Your name</label><input data-model="Order.Name tag=input own=class" class="input"><fieldset data-fieldset="Order.Plan"><legend>label of Order.Plan</legend><input type="radio" data-model="Order.Plan tag=input type=radio value=free own=type+value" value="free"></fieldset><fieldset data-fieldset="Order.Address"><legend>label of Order.Address</legend><label for="id:Address.Street">label of Address.Street</label><input data-model="Address.Street tag=input"><p>field {Address.City} </p><input data-model="Address.City tag=input"></fieldset></form></div><button form="id:Checkout.Form">Save</button><button form="other">Other</button></main> <nil>
