package main

import (
	"context"
	"fmt"
	"errors"
	"strconv"
	"github.com/vuka-lang/ui"
)

type User struct {
	ID   int
	Name string
	Year int
}

func lookup(s string) Result[int] {
	n := strconv.Atoi(s)?
	return Ok(n)
}

func list(users []User, admin bool, s string) ui.Node {
	return <>
		<ul>
			{for _, u := range users {
				<li key={u.ID}>{u.Name} since {u.Year}</li>
			}}
		</ul>
		{if admin {
			<button>Edit</button>
		} else if len(users) == 0 {
			<p>nobody</p> <hr/>
		}
		else {
			guest
		}}
		{match lookup(s) { case Ok(n): <p>{n}</p> case Err(e): <p className="error">{e.Error()}</p> }}
		<nav>{for _, link := range []string{"/", "/users"} { <a href={link}>{link}</a> }}</nav>
		{if ok := map[string]bool{"a": true}["a"]; ok { <i>map in an if</i> }}
		{match len(users) {
		case 0:
			<i>none</i>
		case 1, 2:
			a few: {len(users)}
		default:
			{for i := range 3 { <b>{i}</b> }}
		}}
	</>
}

func main() {
	for _, n := range []ui.Node{
		list(nil, false, "1"),
		list([]User{{1, "Ann", 2020}, {2, "Bo", 2021}}, true, "x"),
	} {
		s, err := ui.String(context.Background(), n)
		fmt.Println(s, err)
	}
	_ = errors.New
}
