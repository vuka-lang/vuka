package main

import (
	"context"
	"fmt"
	"strings"

	"github.com/vuka-lang/ui"
)

// tags returns markup early: ejected, it is one template, the rest of the
// body its else.
func tags(ts []string) ui.Node {
	if len(ts) == 0 {
		return <p class="tags">—</p>
	}
	return <ul class="tags">{for _, t := range ts { <li>{t}</li> }}</ul>
}

// badge computes its class first: a statement line of its template.
func badge(n int, on bool) ui.Node {
	cls := strings.Join([]string{"badge", fmt.Sprint(n)}, "-")
	if on {
		return <b class={cls}>{n}</b>
	} else {
		return <i class={cls}>{n}</i>
	}
}

func main() {
	for _, n := range []ui.Node{tags(nil), tags([]string{"a", "b"}), badge(1, true), badge(2, false)} {
		s, err := ui.String(context.Background(), n)
		fmt.Println(s, err)
	}
}
