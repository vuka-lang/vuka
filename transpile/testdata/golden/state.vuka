package main

import (
	"context"
	"fmt"

	ui "vukatest.local/stateui"
)

type Filters struct {
	Q    string
	Sort string
}

const Env = "env"

// theme is the page's: every component reads one value.
var theme = ui.State("light")

func Menu(label string) ui.Node {
	open := ui.State(false)
	tab := ui.State("logs")
	n := ui.State(2)
	f := ui.State(Filters{Sort: "name"})
	limit := 3
	return <div class={ui.Class{"menu": true, "is-open": open}}>
		<button onClick={open = !open} aria-expanded={open}>{label}</button>
		<ul hidden={!open}>
			<li selected={tab == "env"} onClick={tab = Env; open = false}>
				Env
			</li>
			<li disabled={f.Q == "" || tab != "logs"}>Logs</li>
		</ul>
		<input value={f.Q} onInput={f.Q = "x"} />
		<span>{n}</span> <span>{n + 1}</span> <span>{-n}</span>
		<p
			title={theme + "!"}
			data-ready={!open && tab == Env}
			data-long={len(f.Sort) > limit}
			data-get={tab.Get()}
		/>
		<button onClick={n++}>+</button>
		<button onClick={n--; open = true}>-</button>
		<button onClick={f = Filters{Sort: "name"}}>reset</button>
		<ui.Show when={!open}><p>closed</p></ui.Show>
		<ui.Show when={open}><p>open</p></ui.Show>
		<Panel open={open} sort={f.Sort} />
	</div>
}

// Panel gets its parent's states: the same states.
func Panel(open ui.State[bool], sort ui.State[string]) ui.Node {
	return <p hidden={!open}>{sort}</p>
}

func main() {
	out, err := ui.String(context.Background(), Menu("Menu"))
	fmt.Println(out, err)
	fmt.Println(ui.JS.Set(theme, "dark"))
}
