package main

import (
	"context"
	"fmt"

	"github.com/vuka-lang/ui/v2"
)

type userKey struct{}

// Greeting reads the user from the context its tag renders it with.
func Greeting(ctx context.Context, title string, children ui.Node) ui.Node {
	return <section><h1>{title}, {ctx.Value(userKey{}).(string)}</h1>{children}</section>
}

func Page(n int) ui.Node {
	return <main><Greeting title="Hello"><p>{n} new</p></Greeting></main>
}

func main() {
	out, err := ui.String(context.WithValue(context.Background(), userKey{}, "ada"), Page(3))
	fmt.Println(out, err)
}
