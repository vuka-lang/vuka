package main

import (
	"context"
	"fmt"
	"strings"

	ui "vukatest.local/stateui"
)

var frameMain = ui.Template(`<main title="{{0}}">{{1}}</main>`)

func frame(title string) func(ui.Node) ui.Node {
	return func(page ui.Node) ui.Node { return frameMain.Render(title, page) }
}

// An @ui.Island whose arguments are expressions — a layout, nested calls,
// a string holding parentheses, spread over lines — and another decorator
// after it: the type is still a page backed by its island, and the
// decorator is evaluated at init, its imports kept.
@ui.Island(
	"components/Board.vue",
	ui.Layout(frame(strings.ToUpper("boards (all)")), frame("inner)")),
	ui.Strategy("load"),
)
// Board is a page.
@Tagged("x")
type Board struct {
	ui.Live
	Q string `json:"q"`
}

func Tagged(s string) func(*vuka.Type) { return func(*vuka.Type) {} }

func main() {
	b := &Board{Q: "x"}
	s, err := ui.String(context.Background(), ui.PageLayout(b, b.Render()))
	if err != nil {
		panic(err)
	}
	fmt.Println(s)
}
