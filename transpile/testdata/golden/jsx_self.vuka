package main

import (
	"fmt"
	"regexp"
	"strconv"
	"strings"
)

// This package IS its own JSX target: it declares VukaJSX and the primitives,
// so its .vuka files author JSX that lowers to UNQUALIFIED calls (Template,
// Each, …) resolved within the package — the way github.com/vuka-lang/ui
// authors its own components.
const VukaJSX = 2

type Node interface{ render() string }

type text string

func (t text) render() string { return string(t) }

// Markup renders its holes into its markup, attributes and the space
// between lines left out.
type Markup struct{ src string }

var attrs, lines = regexp.MustCompile(`<(\w+)[^>]*?(/?)>`), regexp.MustCompile(`\n\s*`)

func Template(src string) *Markup {
	return &Markup{lines.ReplaceAllString(attrs.ReplaceAllString(src, "<$1$2>"), "")}
}

func (m *Markup) Render(args ...any) Node {
	s := m.src
	for i, a := range args {
		s = strings.Replace(s, "{{"+strconv.Itoa(i)+"}}", child(a), 1)
	}
	return text(s)
}

func child(v any) string {
	switch v := v.(type) {
	case Node:
		return v.render()
	case []Node:
		var b strings.Builder
		for _, n := range v {
			b.WriteString(n.render())
		}
		return b.String()
	}
	return fmt.Sprint(v)
}

func Each[T any](items []T, fn func(T) Node) Node {
	var b strings.Builder
	for _, it := range items {
		b.WriteString(fn(it).render())
	}
	return text(b.String())
}

func If(cond bool, n Node) Node {
	if !cond {
		return text("")
	}
	return n
}

func Child(v any) Node           { return text(child(v)) }
func Fragment(kids ...Node) Node { return Each(kids, func(n Node) Node { return n }) }

type Row struct {
	ID   int
	Name string
}

// Badge is a same-package component: its tag resolves against this package's
// own scope and lowers to an unqualified call.
func Badge(label string) Node {
	return <span>{label}</span>
}

// list exercises the self-target lowering: plain elements, an {expr} child, a
// {for} loop and a same-package component tag.
func list(title string, rows []Row) Node {
	return <div className="list">
		<h1>{title}</h1>
		<ul>
			{for _, r := range rows {
				<li>
					<Badge label={r.Name} />
					{r.ID}
				</li>
			}}
		</ul>
	</div>
}

func main() {
	fmt.Println(list("People", []Row{{1, "Ada"}, {2, "Lin"}}).render())
}
