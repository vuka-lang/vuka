var handlers = regexp.MustCompile(`data-vk-on-(\w+)="([^"]+)"`)

func show(p live.Patch, err error) {
	for _, u := range p.Updates {
		fmt.Printf("  %s: %s\n", u.ID, u.HTML)
	}
	if p.Error != "" || err != nil {
		fmt.Println("  error:", p.Error, err)
	}
}

func main() {
	ctx := context.Background()
	s, err := ui.String(ctx, page(ctx))
	fmt.Println("static:", s, err)

	sess := live.NewSession(ctx, page)
	html, err := sess.Render()
	fmt.Println("live:", html, err)
	for _, m := range handlers.FindAllStringSubmatch(html, -1) {
		fmt.Println(" ", m[1], m[2])
	}
	fmt.Println("submit milk:")
	show(sess.Event(ui.Event{Target: "c1:0", Type: "submit", Form: url.Values{"name": {"milk"}}}))
