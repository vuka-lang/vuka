package main

import (
	"context"
	"fmt"

	"github.com/vuka-lang/ui"
)

// Box's type argument is inferred from its Value attribute: Value T pins T, so
// <Box Value={7}/> needs no <Box[int]>. The literal still carries the inferred
// argument, &Box[int]{…}, because Go can't infer a composite literal's type.
type Box[T any] struct {
	ui.Live
	Value T
}

// A field reaching the parameter through a slice ([]T) pins it structurally.
type List[T any] struct {
	ui.Live
	Items []T
}

// And one through a pointer (*T).
type Ref[T any] struct {
	ui.Live
	At *T
}

func page(ctx context.Context) ui.Node {
	n := 7
	return pageView(n)
}

func main() {
	fmt.Println(ui.String(context.Background(), page(context.Background())))
}
