import "github.com/a-h/templ"

func UserCard(user User, admin bool, children ui.Node)
<div class="card" data-id={user.ID}>
  <h3>{user.Name}</h3>
  {children}
  if admin {
    <button disabled={!user.Active}>Edit</button>
  }
</div>

// Row takes its struct whole: the attribute names the parameter.
func Row(user User)
<tr><td>{user.Name}</td></tr>

// Badge takes its attributes out of the order of its parameters.
func Badge(label string, count int)
<span>{label}: {count}</span>

func Button(props ButtonProps)
<button>{props.Variant}</button>

func avatarView(url string)
<img src={url} />

func Layout(title string, children ui.Node)
<main>
  <title>{title}</title>
  {children}
</main>

func (t Theme) Card(heading string, children ui.Node)
<section class={map[bool]string{true: "dark"}[t.dark]}>
  <h2>{heading}</h2>
  {children}
</section>

func List(users []User)
<ul>
  for _, u := range users {
    <li key={u.ID}><UserCard user={u} admin={false}>since {u.Year}</UserCard></li>
  }
</ul>
<Badge count={len(users)} label="users" />
<Badge count={2} label={"x"} />
<Button variant="primary" disabled>Save</Button>
<Icon name="star" />
<Icon />
<Avatar url={"a.png"} />
<UserCard />
<table><Row user={users[0]} /></table>
<Layout title="Users"><p>body</p></Layout>
<templ.Raw html="<b>raw</b>">children through templ's context</templ.Raw>

func Themed(theme Theme)
<theme.Card heading="Hi">text</theme.Card>
