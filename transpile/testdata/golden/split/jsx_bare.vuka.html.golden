func list(items []Item)
<ul>
  for _, it := range items {
    if it.Ok {
      <li>{it.Name}</li>
    } else if it.N > 1 {
      <li class="many">{it.Name} x{it.N}</li>
    } else {
      <li class="off">{it.Name}</li>
    }
    for _, t := range it.Tags {
      <i>{t}</i>
    }
    switch it.N {
    case 0:
      <b>none</b>
    case 1:
      for i := range 2 {
        if i == 1 {
          <s>{i}</s>
        }
      }
    default:
      many
    }
    if(it.N == 3) {
      <u>three</u>
    }
    for _, t := range []string{"x"} {
      <em>{t}</em>
    }
  }
</ul>

func texts(items []Item)
<div>
  <p>{"if"} you like</p>
  <p>{"for"} now, match me</p>
  for range items {
    iffy text
  }
  for range items {
    {"if"}-then
  }
  for range items {
    formal matches
  }
  if len(items) > 0 {
    a match?
  }
</div>
