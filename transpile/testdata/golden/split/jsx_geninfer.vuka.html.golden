import "fmt"
import "strconv"

// List's type argument is inferred from its attributes: Items []T pins T, as
// does Key func(T) string. No <List[…]> needed.
func List[T any](p ListProps[T])
<ul>
  for _, it := range p.Items {
    <li id={p.Key(it)}>{fmt.Sprint(it)}</li>
  }
  {p.Children}
</ul>

// Two type parameters, each pinned by one attribute.
func Pair[K comparable, V any](p PairProps[K, V])
<p>{fmt.Sprint(p.Name)}={fmt.Sprint(p.Value)}</p>

// T reached through a named generic type (Column[T]) and a pointer ([]*T) is
// still pinned by unifying those shapes structurally.
func Grid[T any](p GridProps[T])
<table>
  for _, r := range p.Rows {
    <tr>
      for _, col := range p.Cols {
        <td>{col.Get(*r)}</td>
      }
    </tr>
  }
</table>

func page(users []User)
key := func(u User) string { return strconv.Itoa(u.ID) }
<List Items={users} Key={key}><li>done</li></List>
<List[User] Items={nil} Key={nil} />
<Pair Name="age" Value={42} />
<Grid Cols={[]Column[User]{{Head: "id", Get: key}}} Rows={ptrs(users)} />
