package main

// A bare island: onBump lowers to ui.Emit("bump", d.Bump) (no strategy).
func (d *page) bare()
<ui.Island><Counter count={5} onBump={d.Bump} /></ui.Island>

// With a strategy and several emits; the emit name drops the leading on and
// lower-cases its first letter (onRowClick → rowClick, onDelete → delete).
func (d *page) full()
<ui.Island><Counter count={5} client:visible onRowClick={d.RowClick} onDelete={d.Delete} /></ui.Island>
