// Button takes commands: a write built from a state is passed as it is.
func Button(onClick ui.Commands, label string)
<button onClick={onClick}>{label}</button>

// Act takes any handler.
func Act(onClick any, label string)
<Button onClick={onClick.(ui.Commands)} label={label} />

// Hint takes any value: an expression of states is a binding.
func Hint(text any)
<i>{text}</i>

// Panel takes a state: an expression of states is a derived one.
func Panel(hide ui.State[bool])
<p hidden={hide}>panel</p>

// menu takes a state and returns a node.
func (p *Page) menu(open ui.State[bool])
<ul hidden={!open}><li>item</li></ul>
