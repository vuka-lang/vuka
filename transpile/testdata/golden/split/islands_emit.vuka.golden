package main

import (
	"context"
	"fmt"

	ui "vukatest.local/islandui"
)

// Counter is a vanilla island; on<Emit> attributes on its body tag bind the
// component's emits to server handlers, lowered to ui.Emit calls.
@ui.Island("islands/Counter.ts")
type Counter struct {
	Count int `json:"count"`
}

// page carries the emit handlers as methods, so d.Bump etc. are in scope.
type page struct{}

func (d *page) Bump()     {}
func (d *page) RowClick() {}
func (d *page) Delete()   {}

func main() {
	d := &page{}
	b, err := ui.String(context.Background(), d.bare())
	if err != nil {
		panic(err)
	}
	f, err := ui.String(context.Background(), d.full())
	if err != nil {
		panic(err)
	}
	fmt.Println(b)
	fmt.Println(f)
}
