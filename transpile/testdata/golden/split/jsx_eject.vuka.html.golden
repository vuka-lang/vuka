func cardHead(c Card)
<h2>{c.Title}</h2>

func cardView(head ui.Node)
<section>
  {head}
  <p>empty</p>
</section>

func cardView2(c Card, head ui.Node)
<section>
  {head}
  <ul>
    for _, it := range c.Items {
      <li>{it}</li>
    }
  </ul>
  switch len(c.Items) {
  case 1:
    <i>one</i>
  default:
    <i>{wrap(cardB())}</i>
  }
</section>

func homeView()
<main><Card title="Week" items={[]string{"a", "b"}} /></main>

func cardB()
<b>many</b>
