package main

import (
	"context"
	"fmt"

	"github.com/vuka-lang/ui"
)

// Card's markup is built in Go: assigned, passed, returned mid-way.
type Card struct {
	Title string
	Items []string
}

func wrap(n ui.Node) ui.Node { return n }

func (c Card) Render() ui.Node {
	head := cardHead(c)
	if len(c.Items) == 0 {
		return cardView(head)
	}
	return wrap(cardView2(c, head))
}

// framed wraps what it makes in a frame.
func framed(f func() ui.Node) func() ui.Node {
	return func() ui.Node { return ui.HTML(`<div class="frame">{f}</div>`, f()) }
}

// Home is decorated: its markup is a partial, its declaration stays.
@framed
func Home() ui.Node {
	return homeView()
}

func main() {
	for _, n := range []ui.Node{Card{Title: "none"}.Render(), Card{Title: "one", Items: []string{"x"}}.Render(), Home()} {
		s, err := ui.String(context.Background(), n)
		fmt.Println(s, err)
	}
}
