package main

import (
	"fmt"
	"context"
	"errors"
	"io"

	"github.com/vuka-lang/ui"
)

type User struct {
	ID     int
	Name   string
	Active bool
	Year   int
}

type ButtonProps struct {
	Variant  string
	Size     int
	Disabled bool
	Children ui.Node
}

type IconProps struct {
	Name  string
	Class string
}

type html string

func (h html) Render(ctx context.Context, w io.Writer) error {
	_, err := io.WriteString(w, string(h))
	return err
}

// Icon is templUI-style: variadic props, a result that isn't ui.Node.
func Icon(props ...IconProps) html { return "<i></i>" }

func Avatar(url string) (ui.Node, error) {
	if url == "" {
		return nil, errors.New("no url")
	}
	return avatarView(url), nil
}

type Theme struct{ dark bool }

func main() {
	for _, n := range []ui.Node{List([]User{{1, "Ann", true, 2020}}), Themed(Theme{true})} {
		s, err := ui.String(context.Background(), n)
		fmt.Println(s, err)
	}
}
