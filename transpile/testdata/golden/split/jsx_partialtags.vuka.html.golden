package main

import "context"

func navLink(item Item, on bool)
<a href={item.Href} class:on={on}>{item.Label}</a>

func panel(ctx context.Context, title string, footer ui.Node, children ui.Node)
<section>
  <h2>{title} {ctx.Value(userKey{}).(string)}</h2>
  {children}
  <footer>{footer}</footer>
</section>

// Menu uses the package's lowercase functions as tags.
func Menu(items []Item, path string)
<nav>
  for _, i := range items {
    <navLink item={i} on={i.Href == path} />
  }
  <panel title="Me">
    <slot:footer><navLink item={Item{"/out", "Out"}} on /></slot:footer>
    <p>hello</p>
  </panel>
  <my-badge>{navLink(Item{"/x", "X"}, false)}</my-badge>
</nav>
