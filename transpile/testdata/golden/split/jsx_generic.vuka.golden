package main

import (
	"context"
	"fmt"
	"github.com/vuka-lang/ui"
)

type User struct {
	ID   int
	Name string
}

type TableProps[T any] struct {
	Rows []T
	Cell func(T) string
}

// Overloaded components: the attributes' types choose.
func Price(amount int) ui.Node     { return priceView(amount) }
func Price(amount float64) ui.Node { return priceView2(amount) }
func Price(amount string, currency string) ui.Node {
	return priceView3(amount, currency)
}

func main() {
	fmt.Println(ui.String(context.Background(), page([]User{{1, "Ann"}, {2, "Bo"}})))
}
