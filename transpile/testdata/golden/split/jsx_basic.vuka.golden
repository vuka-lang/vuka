package main

import (
	"context"
	"fmt"
	"github.com/vuka-lang/ui"
)

type User struct {
	ID     int
	Name   string
	Active bool
}

func page(u User) ui.Node {
	x := 1
	y := x < 2
	_ = y
	return pageView(u)
}

func main() {
	ch := make(chan int, 1)
	ch <- 1
	_ = <-ch
	s, err := ui.String(context.Background(), page(User{ID: 7, Name: "Ann", Active: true}))
	fmt.Println(s, err)
}
