import "fmt"
import "strconv"

func List[T any](items []T, render func(T) ui.Node)
<ul>
  for _, x := range items {
    {render(x)}
  }
</ul>

// Select's selected is left out: its zero value is the inferred type's.
func Select[T comparable](label string, options []T, selected T)
<label>
  {label}
  <select>
    for _, o := range options {
      <option selected={o == selected}>{fmt.Sprint(o)}</option>
    }
  </select>
</label>

func Table[T any](props TableProps[T])
<table>
  for _, r := range props.Rows {
    <tr><td>{props.Cell(r)}</td></tr>
  }
</table>

func Pair[K comparable, V any](name K, value V, children ui.Node)
<p>{fmt.Sprint(name)}={fmt.Sprint(value)} {children}</p>

func priceView(amount int)
<b>{amount} cents</b>

func priceView2(amount float64)
<b>{strconv.FormatFloat(amount, 'f', 2, 64)}</b>

func priceView3(amount string, currency string)
<b>{amount} {currency}</b>

func page(users []User)
<List items={users} render={func(u User) ui.Node { return pageLi(u) }} />
<List render={func(n int) ui.Node { return pageLi2(n) }} items={[]int{1, 2}} />
<List[string] items={nil} render={nil} />
<Select label="pick" options={[]string{"a", "b"}} />
<Select label="pick" options={[]int{1, 2}} selected={2} />
<Table[User] rows={users} cell={func(u User) string { return strconv.Itoa(u.ID) }} />
<Pair name="a" value={1.5}>and more</Pair>
<Price amount={150} />
<Price amount={1.5} />
<Price amount="7" currency="EUR" />

func pageLi(u User)
<li>{u.Name}</li>

func pageLi2(n int)
<li>{n}</li>
