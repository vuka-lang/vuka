package main

import "context"
import "fmt"

func (b *Box[T]) Render()
<span>box {fmt.Sprint(b.Value)}</span>

func (l *List[T]) Render()
<ul>
  for _, it := range l.Items {
    <li>{fmt.Sprint(it)}</li>
  }
</ul>

func (r *Ref[T]) Render()
<b>{fmt.Sprint(*r.At)}</b>

func page(ctx context.Context)
n := 7
<main>
  <Box Value={1} />
  <Box[string] Value="two" />
  <List Items={[]string{"a", "b"}} />
  <Ref At={&n} />
</main>
