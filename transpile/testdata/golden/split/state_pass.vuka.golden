package main

import (
	"context"
	"fmt"

	ui "vukatest.local/stateui"
)

type Filters struct {
	Kind string
	Open bool
}

// OpenDialog builds a command from the state it is given.
func OpenDialog(s ui.State[bool]) ui.Commands { return s.Set(true) }

// Box takes attributes: a hole where an attribute goes, {attrs...},
// sets them, a binding among them writing its attribute as one in the
// markup would.
func Box(attrs []ui.Attr) ui.Node { return ui.HTML(`<div {attrs...}></div>`, attrs) }

type Page struct{}

func (p *Page) Render() ui.Node {
	open := ui.State(false)
	upload := ui.State(true)
	f := ui.State(Filters{Kind: "dog"})
	return <div>
		<Button onClick={open.Set(true)} label="set" />
		<Button onClick={OpenDialog(upload)} label="upload" />
		<Button onClick={OpenDialog(f.Open)} label="field" />
		<Button onClick={open.Set(true).Set(upload, false)} label="chain" />
		<Act onClick={OpenDialog(upload)} label="any" />
		<Box attrs={[]ui.Attr{ui.BindAttr("aria-expanded", open), ui.BindAttr("data-off", upload), {Name: "id", Value: "box"}}} />
		{p.menu(upload)}
		{p.menu(f.Open)}
		<Hint text={!open} />
		<Hint text={f.Kind + "s"} />
		<Panel hide={!open && upload} />
	</div>
}

func main() {
	out, err := ui.String(context.Background(), (&Page{}).Render())
	fmt.Println(out, err)
}
