package main

import "fmt"

func card(user User, admin bool, children ui.Node)
<div class="card" data-id={user.ID}>
  <h3>{user.Name}</h3>
  {children}
  <p title="it's &quot;quoted&quot;" hidden>Tom &amp; Jerry don't   panic,   it's    fine &lt;3</p>
  <input type="checkbox" checked={user.Active} />
  <span>{fmt.Sprint(user.ID)} items</span> <b>!</b>
</div>

func pageView(u User)
<h1>Hello, {u.Name}!</h1>
{card(u, true, pageEm())}
<hr />

func pageEm()
<em>child</em>
