package main

import "context"

func headerView()
<h1>Pets</h1>

func footerView()
<footer>{year()}</footer>

func linksView()
<a href="/">home</a>

func shellView()
<p>body</p>

func Card(p CardProps)
<div id={p.ID} class={p.Class}>
  {p.Title} {p.Width}x{p.Height}
  {p.Children}
</div>

func (c *Chat) Render()
<ul class={c.Class}>
  for _, l := range c.log {
    <li>{l}</li>
  }
</ul>

func (b *Box[T]) Render()
<b>{b.Value}</b>

func page(ctx context.Context)
w := 3
{header}
<Card title="a" class="c" width={w} ID={1}>!</Card>
<Card width={w} title="b" height={4} />
<Chat room="go" class="chat" />
<Chat ID={2} key={"rust"} room="rust" />
<Box[int] value={7} />
{footer}
{links["home"]}
{shell.Body}
