package main

import ui "vukatest.local/stateui"

type Address struct{ City string }

type User struct {
	ID      int64
	Name    string
	Email   string
	Address Address
}

type Edit struct{ Form *ui.ModelForm[User] }

func (e *Edit) Mount() {
	e.Form = ui.FormOf[User]("Name", "Emial", "Address.Town", "Phone")
}

func (e *Edit) View() ui.Node {
	return <ui.Form for={e.Form}/>
}

func main() {}
