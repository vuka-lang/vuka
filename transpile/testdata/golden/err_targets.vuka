package main

@vuka.Targets(vuka.OnField)
type Char struct{ Max int }

@vuka.Targets(vuka.OnParam | vuka.OnField)
type Path string

@vuka.Targets(vuka.OnFunc)
type Route string

func Size(n int) Char { return Char{Max: n} }

@Char{Max: 1}
func a() {}

@Route("/x")
type T struct {
	F string @Route("/y")
}

func b(@Route("/z") id string, @Size(3) s string) {}

@Path("v")
var v = 1

@vuka.Targets(vuka.OnType)
func c() {}

type fieldOnly = [vuka.OnField]struct{}

// Max is declared for fields the way Go code does, through an alias.
type Max int

func (Max) vukaTargets() fieldOnly { return fieldOnly{} }

type paramOnly [vuka.OnParam]struct{}

// Min is declared for parameters through a named array type.
type Min int

func (Min) vukaTargets() paramOnly { return paramOnly{} }

@Max(3)
func d() {}

@Min(1)
func e() {}
