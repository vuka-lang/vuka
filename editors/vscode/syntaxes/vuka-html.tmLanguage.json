{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Vuka HTML",
  "scopeName": "text.html.vuka",
  "fileTypes": ["vuka.html"],
  "patterns": [
    { "include": "#go-header" },
    { "include": "#go-script" },
    { "include": "#markup" }
  ],
  "repository": {
    "package": {
      "comment": "package layouts: the file's package clause, its first line.",
      "match": "^\\s*(package)\\s+([A-Za-z_]\\w*)",
      "captures": {
        "1": { "name": "keyword.other.package.go" },
        "2": { "name": "entity.name.type.package.go" }
      }
    },
    "imports": {
      "patterns": [
        {
          "match": "^(import)\\s+(?:([A-Za-z_]\\w*)\\s+)?(\"[^\"]*\")",
          "captures": {
            "1": { "name": "keyword.control.import.go" },
            "2": { "name": "entity.name.import.go" },
            "3": { "name": "string.quoted.double.go" }
          }
        },
        {
          "comment": "import ( … ): a grouped import.",
          "begin": "^(import)\\s*(\\()",
          "beginCaptures": {
            "1": { "name": "keyword.control.import.go" },
            "2": { "name": "punctuation.definition.imports.begin.bracket.round.go" }
          },
          "end": "\\)",
          "endCaptures": { "0": { "name": "punctuation.definition.imports.end.bracket.round.go" } },
          "patterns": [
            {
              "match": "(?:([A-Za-z_]\\w*)\\s+)?(\"[^\"]*\")",
              "captures": {
                "1": { "name": "entity.name.import.go" },
                "2": { "name": "string.quoted.double.go" }
              }
            },
            { "match": "//.*$", "name": "comment.line.double-slash.go" }
          ]
        }
      ]
    },
    "header": {
      "comment": "Tolerate an old template signature in markup; new shapes declare one struct in their Go header.",
      "match": "^(func)\\s*(\\([^)]*\\))?\\s*([A-Za-z_]\\w*)\\s*(\\[[^\\]]*\\])?\\s*(\\(.*\\))\\s*$",
      "name": "meta.template.header.vuka",
      "captures": {
        "1": { "name": "keyword.function.go" },
        "2": { "patterns": [{ "include": "#params" }] },
        "3": { "name": "entity.name.function.go" },
        "4": { "patterns": [{ "include": "#params" }] },
        "5": { "patterns": [{ "include": "#params" }] }
      }
    },
    "params": {
      "comment": "A header's receiver, type parameters or parameters: names, then their types.",
      "patterns": [
        { "match": "[()\\[\\],]", "name": "punctuation.other.go" },
        { "match": "\\b[a-z_]\\w*(?=\\s+[*\\[\\]\\w.]+)", "name": "variable.parameter.go" },
        { "match": "\\b(?:[a-z_]\\w*\\.)?[A-Za-z_]\\w*\\b", "name": "entity.name.type.go" },
        { "match": "[*.]", "name": "keyword.operator.go" }
      ]
    },
    "markup": {
      "patterns": [
        { "include": "#header" },
        { "begin": "<!--", "end": "-->", "name": "comment.block.html" },
        { "include": "#comment" },
        { "include": "#escape" },
        { "include": "#script" },
        { "include": "#style" },
        { "include": "#statement" },
        { "include": "#close" },
        { "include": "#hole" },
        { "include": "#tag" },
        { "include": "text.html.basic#entities" }
      ]
    },
    "escape": {
      "match": "\\{\\{",
      "name": "constant.character.escape.vuka"
    },
    "comment": {
      "begin": "\\{/\\*",
      "end": "\\*/\\}",
      "name": "comment.block.vuka"
    },
    "statement": {
      "comment": "A Go statement starting a line: if, for, switch, case, default, an assignment.",
      "begin": "^\\s*(?=(?:\\}\\s*)?(?:if|for|switch|else|match)\\b|case\\b|default\\s*:|[A-Za-z_][\\w.,\\s]*:?=[^=])",
      "end": "(\\{)\\s*$|:\\s*$|$",
      "endCaptures": { "1": { "name": "punctuation.definition.block.begin.go" } },
      "name": "meta.statement.vuka",
      "patterns": [{ "include": "#go-code" }]
    },
    "close": {
      "match": "^\\s*(\\})\\s*$",
      "captures": { "1": { "name": "punctuation.definition.block.end.go" } }
    },
    "hole": {
      "begin": "\\{(?!\\{)",
      "beginCaptures": { "0": { "name": "punctuation.section.embedded.begin.vuka" } },
      "end": "\\}",
      "endCaptures": { "0": { "name": "punctuation.section.embedded.end.vuka" } },
      "name": "meta.embedded.expression.go",
      "contentName": "source.go",
      "patterns": [{ "include": "#go-code" }]
    },
    "braces": {
      "begin": "\\{",
      "end": "\\}",
      "patterns": [{ "include": "#go-code" }]
    },
    "tag": {
      "begin": "(</?)((?:slot:)?[A-Za-z][\\w.:-]*)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "patterns": [{ "include": "#tag-name" }] }
      },
      "end": "(/?>)",
      "endCaptures": { "1": { "name": "punctuation.definition.tag.end.html" } },
      "name": "meta.tag.vuka",
      "patterns": [
        { "include": "#hole" },
        {
          "match": "([A-Za-z_][\\w:.-]*)(?=\\s*=|\\s|/?>)",
          "name": "entity.other.attribute-name.html"
        },
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.html",
          "patterns": [{ "include": "#escape" }, { "include": "#hole" }]
        },
        { "begin": "'", "end": "'", "name": "string.quoted.single.html", "patterns": [{ "include": "#hole" }] }
      ]
    },
    "tag-name": {
      "comment": "An HTML, SVG, MathML or custom element is a tag; Card, ui.Card and a lowercase template or function of the package (navLink) are components.",
      "patterns": [
        { "match": "(?<=<|</)(?:slot:[\\w-]+|(?:feComponentTransfer|feSpecularLighting|feDiffuseLighting|feDisplacementMap|animateTransform|feConvolveMatrix|selectedcontent|annotation\\-xml|feDistantLight|feGaussianBlur|linearGradient|radialGradient|animateMotion|feColorMatrix|foreignObject|mmultiscripts|feDropShadow|feMorphology|fePointLight|feTurbulence|feComposite|feMergeNode|feSpotLight|mprescripts|annotation|blockquote|figcaption|mlabeledtr|munderover|plaintext|semantics|basefont|clipPath|colgroup|datalist|feOffset|fieldset|frameset|menclose|menuitem|metadata|mphantom|noframes|noscript|optgroup|polyline|progress|template|textPath|textarea|acronym|address|animate|article|caption|details|discard|ellipse|feBlend|feFlood|feFuncA|feFuncB|feFuncG|feFuncR|feImage|feMerge|listing|maction|marquee|mpadded|msubsup|noembed|pattern|picture|polygon|section|summary|applet|button|canvas|center|circle|dialog|feTile|figure|filter|footer|header|hgroup|iframe|keygen|legend|marker|merror|mglyph|mspace|mstyle|mtable|munder|object|option|output|portal|script|search|select|source|strike|strong|switch|symbol|aside|audio|blink|embed|frame|image|input|label|meter|mfrac|mover|mpath|mroot|msqrt|mtext|param|small|style|table|tbody|tfoot|thead|title|track|tspan|video|abbr|area|base|body|cite|code|data|defs|desc|font|form|head|html|line|link|main|mark|mask|math|menu|meta|mrow|msub|msup|nobr|path|rect|ruby|samp|slot|span|stop|text|time|view|bdi|bdo|big|col|del|dfn|dir|div|img|ins|kbd|map|mtd|mtr|nav|pre|rtc|set|sub|sup|svg|use|var|wbr|xmp|br|dd|dl|dt|em|h1|h2|h3|h4|h5|h6|hr|li|mi|mn|mo|ms|ol|rb|rp|rt|td|th|tr|tt|ul|a|b|g|i|p|q|s|u)(?![\\w.:-])|[A-Za-z]\\w*[-:][\\w:-]*)", "name": "entity.name.tag.html" },
        { "match": "[\\w.:-]+", "name": "support.class.component.vuka entity.name.tag.component.vuka" }
      ]
    },
    "script": {
      "begin": "(<)(script)\\b(?=[^>]*\\blang\\s*=\\s*[\"']ts[\"'])([^>]*)(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.html" },
        "4": { "name": "punctuation.definition.tag.end.html" }
      },
      "end": "(</)(script)(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.html" },
        "3": { "name": "punctuation.definition.tag.end.html" }
      },
      "contentName": "source.ts",
      "patterns": [{ "include": "source.ts" }]
    },
    "style": {
      "begin": "(<)(style)\\b([^>]*)(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.html" },
        "4": { "name": "punctuation.definition.tag.end.html" }
      },
      "end": "(</)(style)(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.html" },
        "3": { "name": "punctuation.definition.tag.end.html" }
      },
      "contentName": "source.css",
      "patterns": [{ "include": "source.css" }]
    },
    "go-script": {
      "comment": "The shape's Go in its <script lang=\"go\">, the file's first element (2.3).",
      "begin": "(<)(script)\\b(?=[^>]*\\blang\\s*=\\s*[\"']?go\\b)([^>]*)(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.html" },
        "3": { "patterns": [{ "include": "text.html.basic#attribute" }] },
        "4": { "name": "punctuation.definition.tag.end.html" }
      },
      "end": "(</)(script)\\s*(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.html" },
        "3": { "name": "punctuation.definition.tag.end.html" }
      },
      "name": "meta.embedded.block.go",
      "contentName": "source.go",
      "patterns": [{ "include": "#package" }, { "include": "#imports" }, { "include": "#go-code" }]
    },
    "go-header": {
      "begin": "\\A(?![ \\t]*<)",
      "end": "(?=^[ \\t]*<(?!-))",
      "name": "meta.embedded.block.go",
      "contentName": "source.go",
      "patterns": [
        {
          "include": "#package"
        },
        {
          "include": "#imports"
        },
        {
          "include": "#go-code"
        }
      ]
    },
    "go-code": {
      "patterns": [
        {
          "include": "source.vuka#comments"
        },
        {
          "include": "source.vuka#strings"
        },
        {
          "include": "source.vuka#attribute"
        },
        {
          "include": "source.vuka#struct"
        },
        {
          "include": "#go-block"
        },
        {
          "include": "source.go"
        }
      ]
    },
    "go-block": {
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.block.begin.go"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.block.end.go"
        }
      },
      "patterns": [
        {
          "include": "#go-code"
        }
      ]
    }
  }
}
