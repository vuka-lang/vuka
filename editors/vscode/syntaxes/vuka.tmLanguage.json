{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Vuka",
  "scopeName": "source.vuka",
  "fileTypes": [
    "vuka"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#jsx"
    },
    {
      "include": "#struct"
    },
    {
      "include": "#match"
    },
    {
      "include": "#brackets"
    },
    {
      "include": "#staticFunc"
    },
    {
      "include": "#static"
    },
    {
      "include": "#composedDecorator"
    },
    {
      "include": "#decorator"
    },
    {
      "include": "#attribute"
    },
    {
      "include": "#self"
    },
    {
      "include": "#try"
    },
    {
      "include": "#runtime"
    },
    {
      "include": "source.go"
    }
  ],
  "injections": {
    "L:source.vuka - string - comment": {
      "patterns": [
        {
          "include": "#parameterAttribute"
        }
      ]
    }
  },
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.vuka",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.double-slash.vuka",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.raw.vuka",
          "begin": "`",
          "end": "`",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.vuka"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.vuka"
            }
          }
        },
        {
          "name": "string.quoted.double.vuka",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.vuka",
              "match": "\\\\."
            }
          ],
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.vuka"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.vuka"
            }
          }
        }
      ]
    },
    "attribute": {
      "comment": "An attribute or decorator: @T{…} (a composite literal), @f(…) (a call), @T. Before a declaration, or after a struct field and its tag.",
      "patterns": [
        {
          "name": "meta.attribute.vuka",
          "begin": "(@)([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)?)\\s*(\\{)",
          "end": "\\}",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.decorator.vuka"
            },
            "2": {
              "name": "entity.name.function.decorator.vuka"
            },
            "3": {
              "name": "punctuation.definition.begin.bracket.curly.go"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.end.bracket.curly.go"
            }
          },
          "patterns": [
            {
              "include": "$self"
            }
          ]
        },
        {
          "name": "meta.attribute.vuka",
          "begin": "(@)([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)?)\\s*(\\()",
          "end": "\\)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.decorator.vuka"
            },
            "2": {
              "name": "entity.name.function.decorator.vuka"
            },
            "3": {
              "name": "punctuation.definition.begin.bracket.round.go"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.end.bracket.round.go"
            }
          },
          "patterns": [
            {
              "include": "$self"
            }
          ]
        },
        {
          "name": "meta.attribute.vuka",
          "match": "(@)([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)?)",
          "captures": {
            "1": {
              "name": "punctuation.definition.decorator.vuka"
            },
            "2": {
              "name": "entity.name.function.decorator.vuka"
            }
          }
        }
      ]
    },
    "struct": {
      "comment": "A struct body: fields, their types, tags and attributes, and statics.",
      "begin": "(?:(?<![\\w.])(type)\\s+([A-Za-z_][A-Za-z0-9_]*)(\\[[^\\]]*\\])?\\s+)?(?<![\\w.])(struct)\\s*(\\{)",
      "beginCaptures": {
        "1": {
          "name": "keyword.type.go"
        },
        "2": {
          "name": "entity.name.type.go"
        },
        "3": {
          "patterns": [
            {
              "include": "#type-expr"
            }
          ]
        },
        "4": {
          "name": "keyword.struct.go"
        },
        "5": {
          "name": "punctuation.definition.begin.bracket.curly.go"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.end.bracket.curly.go"
        }
      },
      "name": "meta.struct.vuka",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#static"
        },
        {
          "include": "#attribute"
        },
        {
          "include": "#struct-field"
        },
        {
          "include": "$self"
        }
      ]
    },
    "struct-field": {
      "patterns": [
        {
          "comment": "An embedded field: a type alone, then maybe a tag, attributes or a comment.",
          "match": "(?:^|(?<=[{;]))\\s*(\\*)?(?:([A-Za-z_][A-Za-z0-9_]*)(\\.))?([A-Za-z_][A-Za-z0-9_]*)(\\[[^\\]]*\\])?(?=\\s*(?:@|`|\"|//|;|\\}|$))",
          "captures": {
            "1": {
              "name": "keyword.operator.pointer.vuka"
            },
            "2": {
              "name": "entity.name.type.package.go"
            },
            "3": {
              "name": "punctuation.other.period.go"
            },
            "4": {
              "name": "entity.name.type.embedded.vuka"
            },
            "5": {
              "patterns": [
                {
                  "include": "#type-expr"
                }
              ]
            }
          }
        },
        {
          "comment": "Named fields and their type, up to the tag, an attribute or a comment.",
          "begin": "(?:^|(?<=[{;]))\\s*([A-Za-z_][A-Za-z0-9_]*(?:\\s*,\\s*[A-Za-z_][A-Za-z0-9_]*)*)\\s+(?=[^\\s@`/;}])",
          "beginCaptures": {
            "1": {
              "patterns": [
                {
                  "match": "[A-Za-z_][A-Za-z0-9_]*",
                  "name": "variable.other.field.vuka"
                },
                {
                  "match": ",",
                  "name": "punctuation.other.comma.go"
                }
              ]
            }
          },
          "end": "(?=[@`\";}]|//)|$",
          "patterns": [
            {
              "include": "#type-expr"
            }
          ]
        }
      ]
    },
    "type-expr": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#struct"
        },
        {
          "match": "(?<![\\w.])interface\\s*\\{\\s*\\}",
          "name": "keyword.interface.go"
        },
        {
          "match": "(?<![\\w.])(map|chan|func|interface)\\b",
          "name": "keyword.type.vuka"
        },
        {
          "include": "#self"
        },
        {
          "match": "(?<![\\w.])(Result|Option)\\b",
          "name": "support.type.vuka"
        },
        {
          "match": "(?<![\\w.])(any|bool|byte|comparable|complex64|complex128|error|float32|float64|int|int8|int16|int32|int64|rune|string|uint|uint8|uint16|uint32|uint64|uintptr)\\b",
          "name": "storage.type.vuka"
        },
        {
          "match": "([A-Za-z_][A-Za-z0-9_]*)(\\.)(?=[A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "entity.name.type.package.go"
            },
            "2": {
              "name": "punctuation.other.period.go"
            }
          }
        },
        {
          "match": "[A-Za-z_][A-Za-z0-9_]*",
          "name": "entity.name.type.vuka"
        },
        {
          "match": "\\d+",
          "name": "constant.numeric.decimal.go"
        },
        {
          "match": "\\[",
          "name": "punctuation.definition.begin.bracket.square.go"
        },
        {
          "match": "\\]",
          "name": "punctuation.definition.end.bracket.square.go"
        },
        {
          "match": "\\*",
          "name": "keyword.operator.pointer.vuka"
        },
        {
          "match": ",",
          "name": "punctuation.other.comma.go"
        },
        {
          "begin": "\\(",
          "end": "\\)",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.begin.bracket.round.go"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.end.bracket.round.go"
            }
          },
          "patterns": [
            {
              "include": "#type-expr"
            }
          ]
        }
      ]
    },
    "self": {
      "patterns": [
        {
          "match": "(?<![\\w.])Self\\b",
          "name": "variable.language.self.vuka"
        },
        {
          "match": "(?<![\\w.])self\\b",
          "name": "variable.language.self.vuka"
        }
      ]
    },
    "match": {
      "comment": "A match statement: its header is Go, its cases patterns.",
      "begin": "(?<![\\w.])(match)(?=\\s+[^\\s=:.,;)\\]}][^;]*\\{\\s*(?://.*)?$)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.match.vuka"
        }
      },
      "end": "(?<=\\})",
      "patterns": [
        {
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.begin.bracket.curly.go"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.end.bracket.curly.go"
            }
          },
          "patterns": [
            {
              "include": "#match-case"
            },
            {
              "include": "$self"
            }
          ]
        },
        {
          "include": "$self"
        }
      ]
    },
    "match-case": {
      "begin": "(?:^|(?<=[{>}]))\\s*(?<![\\w.])(case|default)\\b",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.vuka"
        }
      },
      "end": ":(?!=)",
      "endCaptures": {
        "0": {
          "name": "punctuation.other.colon.go"
        }
      },
      "name": "meta.pattern.vuka",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "match": "(?<![\\w.])if\\b",
          "name": "keyword.control.guard.vuka"
        },
        {
          "match": "(\\^)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.operator.pin.vuka"
            },
            "2": {
              "name": "variable.other.vuka"
            }
          }
        },
        {
          "match": "(?<![\\w.])_(?!\\w)",
          "name": "variable.language.wildcard.vuka"
        },
        {
          "include": "#runtime"
        },
        {
          "include": "$self"
        }
      ]
    },
    "try": {
      "match": "(?<=[\\w)\\]])\\?",
      "name": "keyword.operator.try.vuka"
    },
    "runtime": {
      "patterns": [
        {
          "name": "support.type.vuka",
          "match": "(?<![\\w.])(Result|Option)\\b(?=\\s*\\[)"
        },
        {
          "name": "support.function.vuka",
          "match": "(?<![\\w.])(Ok|Err|Some)\\b(?=\\s*[(\\[])"
        },
        {
          "name": "support.constant.vuka",
          "match": "(?<![\\w.])None\\b"
        }
      ]
    },
    "decorator": {
      "match": "^\\s*(decorator)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.other.decorator.vuka storage.type.function.vuka"
        },
        "2": {
          "name": "entity.name.function.decorator.vuka"
        }
      }
    },
    "static": {
      "match": "^\\s*(static)\\b(?:\\s+(const)\\b)?\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "storage.modifier.static.vuka"
        },
        "2": {
          "name": "storage.modifier.const.vuka"
        },
        "3": {
          "name": "variable.other.property.static.vuka"
        }
      }
    },
    "staticFunc": {
      "match": "^(func)\\s+([A-Za-z_][A-Za-z0-9_]*)(\\[[^\\]]*\\])?(\\.)([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
      "captures": {
        "1": {
          "name": "keyword.function.vuka storage.type.function.vuka"
        },
        "2": {
          "name": "entity.name.type.vuka"
        },
        "3": {
          "patterns": [
            {
              "include": "#type-expr"
            }
          ]
        },
        "4": {
          "name": "punctuation.other.period.go"
        },
        "5": {
          "name": "entity.name.function.static.vuka"
        }
      }
    },
    "brackets": {
      "comment": "Go's brackets, kept here so what's inside them is Vuka (Go's own include only Go).",
      "patterns": [
        {
          "begin": "\\{",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.begin.bracket.curly.go"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.end.bracket.curly.go"
            }
          },
          "patterns": [
            {
              "include": "$self"
            }
          ]
        },
        {
          "begin": "\\(",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.begin.bracket.round.go"
            }
          },
          "end": "\\)",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.end.bracket.round.go"
            }
          },
          "patterns": [
            {
              "include": "$self"
            }
          ]
        },
        {
          "begin": "\\[",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.begin.bracket.square.go"
            }
          },
          "end": "\\]",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.end.bracket.square.go"
            }
          },
          "patterns": [
            {
              "include": "$self"
            }
          ]
        }
      ]
    },
    "jsx": {
      "comment": "An element where an expression starts: after return, = ( , { : [ or at the start of a line, < then a letter or >. a < b, x<y and <-ch stay Go.",
      "begin": "(?:(?<=\\breturn)|(?<=[=(,{\\[:])|^)\\s*(?=<(?:[A-Za-z_]|>))",
      "end": "(?<=>)",
      "patterns": [
        {
          "include": "#jsx-element"
        }
      ]
    },
    "jsx-element": {
      "name": "meta.tag.jsx.vuka",
      "begin": "(<)(?:([A-Za-z_][\\w.:-]*)(\\[[^\\]<>]*\\])?|(?=>))",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.jsx.vuka"
        },
        "2": {
          "patterns": [
            {
              "include": "#jsx-tag-name"
            }
          ]
        },
        "3": {
          "patterns": [
            {
              "include": "#jsx-type-args"
            }
          ]
        }
      },
      "end": "(/>)|(?:(</)(?:([A-Za-z_][\\w.:-]*)(\\[[^\\]<>]*\\])?)?\\s*(>))",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.end.jsx.vuka"
        },
        "2": {
          "name": "punctuation.definition.tag.begin.jsx.vuka"
        },
        "3": {
          "patterns": [
            {
              "include": "#jsx-tag-name"
            }
          ]
        },
        "4": {
          "patterns": [
            {
              "include": "#jsx-type-args"
            }
          ]
        },
        "5": {
          "name": "punctuation.definition.tag.end.jsx.vuka"
        }
      },
      "patterns": [
        {
          "include": "#jsx-attributes"
        },
        {
          "include": "#jsx-children"
        }
      ]
    },
    "jsx-tag-name": {
      "comment": "div is an HTML tag; Card, theme.Card and List[User] are components.",
      "patterns": [
        {
          "match": "(?<=<|</)[a-z][\\w:-]*(?![\\w.:-])",
          "name": "entity.name.tag.vuka"
        },
        {
          "match": "([A-Za-z_][A-Za-z0-9_]*)(\\.)",
          "captures": {
            "1": {
              "name": "entity.name.type.package.go"
            },
            "2": {
              "name": "punctuation.accessor.vuka"
            }
          }
        },
        {
          "match": "[\\w:-]+",
          "name": "entity.name.type.component.vuka"
        }
      ]
    },
    "jsx-type-args": {
      "patterns": [
        {
          "include": "#type-expr"
        }
      ]
    },
    "jsx-attributes": {
      "begin": "\\G",
      "end": "(?=/>)|(>)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.end.jsx.vuka"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "match": "(?<![\\w.:@-])key(?![\\w.:-])",
          "name": "variable.language.key.jsx.vuka"
        },
        {
          "match": "(?<![\\w.:@-])on[A-Z]\\w*(?![\\w.:-])",
          "name": "entity.name.function.event.jsx.vuka"
        },
        {
          "match": "[A-Za-z_@:][\\w.:-]*",
          "name": "entity.other.attribute-name.jsx.vuka"
        },
        {
          "match": "=",
          "name": "punctuation.separator.key-value.jsx.vuka"
        },
        {
          "name": "string.quoted.double.jsx.vuka",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.jsx.vuka"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.jsx.vuka"
            }
          },
          "patterns": [
            {
              "include": "#jsx-entity"
            }
          ]
        },
        {
          "name": "string.quoted.single.jsx.vuka",
          "begin": "'",
          "end": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.jsx.vuka"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.jsx.vuka"
            }
          },
          "patterns": [
            {
              "include": "#jsx-entity"
            }
          ]
        },
        {
          "include": "#jsx-expression"
        }
      ]
    },
    "jsx-children": {
      "patterns": [
        {
          "include": "#jsx-element"
        },
        {
          "include": "#jsx-comment"
        },
        {
          "include": "#jsx-expression"
        },
        {
          "include": "#jsx-entity"
        },
        {
          "match": "[^<{&]+",
          "name": "string.unquoted.jsx.text.vuka"
        }
      ]
    },
    "jsx-comment": {
      "match": "(\\{)\\s*(/\\*.*?\\*/)\\s*(\\})",
      "captures": {
        "0": {
          "name": "comment.block.jsx.vuka"
        },
        "1": {
          "name": "punctuation.section.embedded.begin.jsx.vuka"
        },
        "3": {
          "name": "punctuation.section.embedded.end.jsx.vuka"
        }
      }
    },
    "jsx-entity": {
      "match": "&(?:[A-Za-z][A-Za-z0-9]*|#[0-9]+|#x[0-9A-Fa-f]+);",
      "name": "constant.character.entity.jsx.vuka"
    },
    "jsx-expression": {
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.embedded.begin.jsx.vuka"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.jsx.vuka"
        }
      },
      "contentName": "meta.embedded.expression.vuka",
      "patterns": [
        {
          "include": "#jsx-block"
        },
        {
          "include": "$self"
        }
      ]
    },
    "jsx-block": {
      "comment": "{for …}, {if …}, {match …} in markup, and the same blocks nested without braces at the start of a child in a block's body: a Go header, then a body of markup.",
      "begin": "(?:^|(?<=[{>}]))\\s*(?<![\\w.])(?:(if|for)(?=[\\s(])|(match)(?=\\s+[^\\s{=:.,;)\\]}]))",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.vuka"
        },
        "2": {
          "name": "keyword.control.match.vuka"
        }
      },
      "end": "(?<=\\})(?!\\s*else\\b)",
      "name": "meta.block.jsx.vuka",
      "patterns": [
        {
          "include": "#jsx-body"
        },
        {
          "match": "(?<![\\w.])(else)(?:\\s+(if)(?=[\\s(]))?",
          "captures": {
            "1": {
              "name": "keyword.control.vuka"
            },
            "2": {
              "name": "keyword.control.vuka"
            }
          }
        },
        {
          "include": "$self"
        }
      ]
    },
    "jsx-body": {
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.block.begin.jsx.vuka"
        }
