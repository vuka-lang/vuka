{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Vuka",
  "scopeName": "source.vuka",
  "fileTypes": [
    "vuka"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#jsx"
    },
    {
      "include": "#brackets"
    },
    {
      "include": "#staticFunc"
    },
    {
      "include": "#static"
    },
    {
      "include": "#decorator"
    },
    {
      "include": "#attribute"
    },
    {
      "include": "#match"
    },
    {
      "include": "#try"
    },
    {
      "include": "#runtime"
    },
    {
      "include": "source.go"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.vuka",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.double-slash.vuka",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.raw.vuka",
          "begin": "`",
          "end": "`",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.vuka"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.vuka"
            }
          }
        },
        {
          "name": "string.quoted.double.vuka",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.vuka",
              "match": "\\\\."
            }
          ],
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.vuka"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.vuka"
            }
          }
        }
      ]
    },
    "attribute": {
      "match": "(@)([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)?)",
      "captures": {
        "1": {
          "name": "punctuation.definition.decorator.vuka"
        },
        "2": {
          "name": "entity.name.function.decorator.vuka"
        }
      }
    },
    "match": {
      "match": "(?<![\\w.])(match)(?=\\s+[^\\s=:.,;)\\]}][^;]*\\{\\s*(?://.*)?$)",
      "captures": {
        "1": {
          "name": "keyword.control.match.vuka"
        }
      }
    },
    "try": {
      "match": "(?<=[\\w)\\]])\\?",
      "name": "keyword.operator.try.vuka"
    },
    "runtime": {
      "patterns": [
        {
          "name": "support.type.vuka",
          "match": "\\b(Result|Option)\\b(?=\\s*\\[)"
        },
        {
          "name": "support.function.vuka",
          "match": "\\b(Ok|Err|Some)\\b(?=\\s*[(\\[])"
        },
        {
          "name": "support.constant.vuka",
          "match": "\\bNone\\b"
        }
      ]
    },
    "decorator": {
      "match": "^\\s*(decorator)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.other.decorator.vuka storage.type.function.vuka"
        },
        "2": {
          "name": "entity.name.function.decorator.vuka"
        }
      }
    },
    "static": {
      "match": "^\\s*(static)\\b(?:\\s+(const)\\b)?\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "storage.modifier.static.vuka"
        },
        "2": {
          "name": "storage.modifier.const.vuka"
        },
        "3": {
          "name": "variable.other.property.static.vuka"
        }
      }
    },
    "staticFunc": {
      "match": "^(func)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\[[^\\]]*\\])?(\\.)([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
      "captures": {
        "1": {
          "name": "keyword.function.vuka storage.type.function.vuka"
        },
        "2": {
          "name": "entity.name.type.vuka"
        },
        "4": {
          "name": "entity.name.function.static.vuka"
        }
      }
    },
    "brackets": {
      "comment": "Go's brackets, kept here so what's inside them is Vuka (Go's own include only Go).",
      "patterns": [
        {
          "begin": "\\{",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.begin.bracket.curly.go"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.end.bracket.curly.go"
            }
          },
          "patterns": [
            {
              "include": "$self"
            }
          ]
        },
        {
          "begin": "\\(",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.begin.bracket.round.go"
            }
          },
          "end": "\\)",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.end.bracket.round.go"
            }
          },
          "patterns": [
            {
              "include": "$self"
            }
          ]
        },
        {
          "begin": "\\[",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.begin.bracket.square.go"
            }
          },
          "end": "\\]",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.end.bracket.square.go"
            }
          },
          "patterns": [
            {
              "include": "$self"
            }
          ]
        }
      ]
    },
    "jsx": {
      "comment": "An element where an expression starts: after return, = ( , { : [ or at the start of a line, < then a letter or >. a < b, x<y and <-ch stay Go.",
      "begin": "(?:(?<=\\breturn)|(?<=[=(,{\\[:])|^)\\s*(?=<(?:[A-Za-z_]|>))",
      "end": "(?<=>)",
      "patterns": [
        {
          "include": "#jsx-element"
        }
      ]
    },
    "jsx-element": {
      "name": "meta.tag.jsx.vuka",
      "begin": "(<)([A-Za-z_][\\w.:-]*|(?=>))",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.jsx.vuka"
        },
        "2": {
          "patterns": [
            {
              "match": "(?<=<|</)[a-z][\\w:-]*(?![\\w.:-])",
              "name": "entity.name.tag.vuka"
            },
            {
              "match": "[\\w.:-]+",
              "name": "support.class.component.vuka"
            }
          ]
        }
      },
      "end": "(/>)|(?:(</)([A-Za-z_][\\w.:-]*)?\\s*(>))",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.end.jsx.vuka"
        },
        "2": {
          "name": "punctuation.definition.tag.begin.jsx.vuka"
        },
        "3": {
          "patterns": [
            {
              "match": "(?<=<|</)[a-z][\\w:-]*(?![\\w.:-])",
              "name": "entity.name.tag.vuka"
            },
            {
              "match": "[\\w.:-]+",
              "name": "support.class.component.vuka"
            }
          ]
        },
        "4": {
          "name": "punctuation.definition.tag.end.jsx.vuka"
        }
      },
      "patterns": [
        {
          "include": "#jsx-attributes"
        },
        {
          "include": "#jsx-children"
        }
      ]
    },
    "jsx-attributes": {
      "begin": "\\G",
      "end": "(?=/>)|(>)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.end.jsx.vuka"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "match": "[A-Za-z_@:][\\w.:-]*",
          "name": "entity.other.attribute-name.jsx.vuka"
        },
        {
          "match": "=",
          "name": "punctuation.separator.key-value.jsx.vuka"
        },
        {
          "name": "string.quoted.double.jsx.vuka",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.jsx.vuka"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.jsx.vuka"
            }
          },
          "patterns": [
            {
              "include": "#jsx-entity"
            }
          ]
        },
        {
          "name": "string.quoted.single.jsx.vuka",
          "begin": "'",
          "end": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.jsx.vuka"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.jsx.vuka"
            }
          },
          "patterns": [
            {
              "include": "#jsx-entity"
            }
          ]
        },
        {
          "include": "#jsx-expression"
        }
      ]
    },
    "jsx-children": {
      "patterns": [
        {
          "include": "#jsx-element"
        },
        {
          "include": "#jsx-expression"
        },
        {
          "include": "#jsx-entity"
        },
        {
          "match": "[^<{&]+",
          "name": "string.unquoted.jsx.text.vuka"
        }
      ]
    },
    "jsx-entity": {
      "match": "&(?:[A-Za-z][A-Za-z0-9]*|#[0-9]+|#x[0-9A-Fa-f]+);",
      "name": "constant.character.entity.jsx.vuka"
    },
    "jsx-expression": {
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.embedded.begin.jsx.vuka"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.jsx.vuka"
        }
      },
      "contentName": "meta.embedded.expression.vuka",
      "patterns": [
        {
          "include": "$self"
        }
      ]
    }
  }
}
