{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Vuka",
  "scopeName": "source.vuka",
  "fileTypes": [
    "vuka"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#staticFunc"
    },
    {
      "include": "#static"
    },
    {
      "include": "#decorator"
    },
    {
      "include": "#attribute"
    },
    {
      "include": "#match"
    },
    {
      "include": "#try"
    },
    {
      "include": "#runtime"
    },
    {
      "include": "source.go"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.vuka",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.double-slash.vuka",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.raw.vuka",
          "begin": "`",
          "end": "`"
        },
        {
          "name": "string.quoted.double.vuka",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.vuka",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "attribute": {
      "match": "(@)([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)?)",
      "captures": {
        "1": {
          "name": "punctuation.definition.decorator.vuka"
        },
        "2": {
          "name": "entity.name.function.decorator.vuka"
        }
      }
    },
    "match": {
      "match": "(?<![\\w.])(match)(?=\\s+[^\\s=:.,;)\\]}][^;]*\\{\\s*(?://.*)?$)",
      "captures": {
        "1": {
          "name": "keyword.control.match.vuka"
        }
      }
    },
    "try": {
      "match": "(?<=[\\w)\\]])\\?",
      "name": "keyword.operator.try.vuka"
    },
    "runtime": {
      "patterns": [
        {
          "name": "support.type.vuka",
          "match": "\\b(Result|Option)\\b(?=\\s*\\[)"
        },
        {
          "name": "support.function.vuka",
          "match": "\\b(Ok|Err|Some)\\b(?=\\s*[(\\[])"
        },
        {
          "name": "support.constant.vuka",
          "match": "\\bNone\\b"
        }
      ]
    },
    "decorator": {
      "match": "^\\s*(decorator)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.other.decorator.vuka storage.type.function.vuka"
        },
        "2": {
          "name": "entity.name.function.decorator.vuka"
        }
      }
    },
    "static": {
      "match": "^\\s*(static)\\b(?:\\s+(const)\\b)?\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "storage.modifier.static.vuka"
        },
        "2": {
          "name": "storage.modifier.const.vuka"
        },
        "3": {
          "name": "variable.other.property.static.vuka"
        }
      }
    },
    "staticFunc": {
      "match": "^(func)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\[[^\\]]*\\])?(\\.)([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
      "captures": {
        "1": {
          "name": "keyword.function.vuka storage.type.function.vuka"
        },
        "2": {
          "name": "entity.name.type.vuka"
        },
        "4": {
          "name": "entity.name.function.static.vuka"
        }
      }
    }
  }
}
