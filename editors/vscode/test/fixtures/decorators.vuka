decorator ApiRoute(path string) = @web.Get(path) @web.Use(auth) @timed
decorator Audited = @logged @Doc("audited")
decorator Service = (
	@register
	@Audited
)

@ApiRoute("/pets/{id}")
func ShowPet(@Path("id") id int, @Query("q") q string, @Body @Valid in NewPet, store *PetStore) Result[Pet] {
