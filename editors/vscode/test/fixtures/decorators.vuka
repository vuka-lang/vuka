package main

decorator logged(c) {
	fmt.Println("->", c.Name, c.Args)
	c.Next()
}

decorator retry(times int)(c) {
	for i := 0; i < times; i++ {
		if c.Next(); c.Err() == nil {
			return
		}
	}
}

@retry(3)
@logged
func charge(ctx context.Context, id int) (Receipt, error) {
	return Receipt{}, nil
}

@web.Get("/pets/{id}")
@web.Template("views/pet.html")
