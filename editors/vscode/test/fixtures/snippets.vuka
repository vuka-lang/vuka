// ORM model
type Post struct {
	orm.Base              @orm.Meta{Table: "posts"}
	ID       int64        @orm.PK
	Title    string       @orm.Char{Max: 200}
	Author   orm.FK[User] @orm.Rel{OnDelete: orm.Cascade}

}

// Decorator
decorator logged(c) {

	c.Next()
}

// Decorator with parameters
decorator retry(times int)(c) {
	for i := 0; i < times; i++ {
		if c.Next(); c.Err() == nil {
			return
		}
	}
}

// Transaction
