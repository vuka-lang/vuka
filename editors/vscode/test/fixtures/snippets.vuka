// Live page
@web.Live("/counter")
type LiveCounter struct {
	vuka.Live
	Start int // ?start=3
	n     int
}

func (c *LiveCounter) Mount() { c.n = c.Start }
func (c *LiveCounter) Inc()   { c.n++ }

func (c *LiveCounter) Render() vuka.Node {
	return <div><output>{c.n}</output><button onClick={c.Inc}>+</button></div>
}

// Web app main
func main() {
	app := web.New(web.Require("DATABASE_URL"))
	app.Run("") // :$PORT, else :8080
}

// ORM model
type Post struct {
	orm.Base              @orm.Meta{Table: "posts"}
	ID       int64        @orm.PK
	Title    string       @orm.Char{Max: 200}
	Author   orm.FK[User] @orm.Rel{OnDelete: orm.Cascade}

}

// Decorator
decorator logged(c) {

	c.Next()
}

// Decorator with parameters
decorator retry(times int)(c) {
	for i := 0; i < times; i++ {
		if c.Next(); c.Err() == nil {
			return
		}
	}
}

// Transaction
@orm.Transaction
func publish(ctx context.Context, slug string) error {

	return nil
}

