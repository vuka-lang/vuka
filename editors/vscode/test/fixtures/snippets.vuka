// The snippets (snippets/vuka.json) expanded with their defaults, as vuka fmt prints them.
package main

// Stateful component
type Counter struct {
	vuka.Live
	Start int // a prop: <Counter Start={…} />
	n     int // state
}

func (c *Counter) Mount(ctx context.Context) error {
	c.n = c.Start
	return nil
}

func (c *Counter) Inc() { c.n++ }

func (c *Counter) Render() vuka.Node {
	return <div><span>{c.n}</span><button onClick={c.Inc}>+</button></div>
}

// Stateless component
func Card(title string, children vuka.Node) vuka.Node {
	return <section>{children}</section>
}

// match Result
func friv2() vuka.Node {
	match expr {
	case Ok(v):

	case Err(err):
		return err
	}
	return nil
}

// match Option
func fb858() vuka.Node {
	match expr {
	case Some(v):

	case None:

	}
	return nil
}

// match block in markup
func fchvg() vuka.Node {
	return <div>
		{match expr {
		case Ok(v):
			<p>{v}</p>
		case Err(e):
			<p className="error">{e}</p>
		}}
	</div>
}

// for block in markup
func fgdds() vuka.Node {
	return <div>
		{for _, it := range items {
			<li key={it.ID}></li>
		}}
	</div>
}

