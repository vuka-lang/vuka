{
  "name": "vuka",
  "displayName": "Vuka",
  "description": "Vuka language support: Go with Result, Option, ?, match, overloading and attributes. Completion, navigation, rename and diagnostics through gopls.",
  "version": "0.3.0",
  "publisher": "vuka-lang",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/vuka-lang/vuka"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "vuka",
    "go",
    "golang",
    "transpiler"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:vuka"
  ],
  "contributes": {
    "languages": [
      {
        "id": "vuka",
        "aliases": [
          "Vuka",
          "vuka"
        ],
        "extensions": [
          ".vuka"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/file-icon.svg",
          "dark": "./images/file-icon.svg"
        }
      },
      {
        "id": "templ",
        "aliases": [
          "templ"
        ],
        "extensions": [
          ".templ"
        ],
        "icon": {
          "light": "./images/templ-file-icon.png",
          "dark": "./images/templ-file-icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "vuka",
        "scopeName": "source.vuka",
        "path": "./syntaxes/vuka.tmLanguage.json",
        "embeddedLanguages": {
          "source.go": "go"
        }
      }
    ],
    "configurationDefaults": {
      "[vuka]": {
        "editor.formatOnSave": true
      }
    },
    "configuration": {
      "title": "Vuka",
      "properties": {
        "vuka.path": {
          "type": "string",
          "default": "vuka",
          "description": "The vuka binary (install: go install github.com/vuka-lang/vuka/cmd/vuka@latest)."
        },
        "vuka.goplsPath": {
          "type": "string",
          "default": "",
          "description": "The gopls binary vuka lsp runs. Empty: gopls on PATH, then $GOBIN, then $GOPATH/bin."
        },
        "vuka.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace the messages between VS Code and vuka lsp."
        },
        "vuka.sharedGopls": {
          "type": "boolean",
          "default": true,
          "description": "Share one gopls daemon (gopls -remote=auto) between the Vuka server, the Go extension and other windows."
        },
        "vuka.offerGoDropIn": {
          "type": "boolean",
          "default": true,
          "description": "Offer to serve Go files through Vuka too (go.alternateTools.gopls), so .go files see code from .vuka files."
        },
        "vuka.offerTemplDropIn": {
          "type": "boolean",
          "default": true,
          "description": "Offer to let templ's language server use Vuka as its gopls (templ.executablePath), so .templ files see code from .vuka files."
        }
      }
    },
    "commands": [
      {
        "command": "vuka.restartServer",
        "title": "Vuka: Restart Language Server"
      },
      {
        "command": "vuka.serveGoFiles",
        "title": "Vuka: Serve Go Files Too"
      },
      {
        "command": "vuka.stopServingGoFiles",
        "title": "Vuka: Stop Serving Go Files"
      },
      {
        "command": "vuka.serveTemplFiles",
        "title": "Vuka: Let templ Use Vuka as Its gopls"
      },
      {
        "command": "vuka.stopServingTemplFiles",
        "title": "Vuka: Stop templ Using Vuka"
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.1"
  },
  "scripts": {
    "package": "vsce package"
  }
}
