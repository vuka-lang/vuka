{
  "name": "vuka",
  "displayName": "Vuka",
  "description": "Language support for Vuka 2.0: Go logic and .vuka.html shapes, live pages and islands. Completion, navigation, rename, diagnostics and formatting through gopls.",
  "version": "0.9.1",
  "publisher": "vuka-lang",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/vuka-lang/vuka"
  },
  "homepage": "https://vuka-lang.github.io/",
  "bugs": {
    "url": "https://github.com/vuka-lang/vuka/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Formatters"
  ],
  "keywords": [
    "vuka",
    "go",
    "golang",
    "html templates",
    "components",
    "live",
    "islands",
    "orm",
    "typescript"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:vuka",
    "onLanguage:vuka-html"
  ],
  "contributes": {
    "languages": [
      {
        "id": "vuka",
        "aliases": [
          "Vuka",
          "vuka"
        ],
        "extensions": [
          ".vuka"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/file-icon.svg",
          "dark": "./images/file-icon.svg"
        }
      },
      {
        "id": "vuka-html",
        "aliases": [
          "Vuka HTML",
          "vuka-html"
        ],
        "extensions": [
          ".vuka.html"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/file-icon.svg",
          "dark": "./images/file-icon.svg"
        }
      },
      {
        "id": "templ",
        "aliases": [
          "templ"
        ],
        "extensions": [
          ".templ"
        ],
        "icon": {
          "light": "./images/templ-file-icon.png",
          "dark": "./images/templ-file-icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "vuka",
        "scopeName": "source.vuka",
        "path": "./syntaxes/vuka.tmLanguage.json",
        "embeddedLanguages": {
          "source.go": "go"
        }
      },
      {
        "language": "vuka-html",
        "scopeName": "text.html.vuka",
        "path": "./syntaxes/vuka-html.tmLanguage.json",
        "embeddedLanguages": {
          "source.go": "go",
          "source.ts": "typescript",
          "source.css": "css",
          "meta.embedded.expression.go": "go",
          "meta.statement.vuka": "go",
          "meta.embedded.block.go": "go"
        },
        "tokenTypes": {
          "meta.embedded.expression.go": "other",
          "meta.statement.vuka": "other",
          "meta.embedded.block.go": "other"
        }
      },
      {
        "scopeName": "inline.vuka-html",
        "path": "./syntaxes/vuka-html-injection.tmLanguage.json",
        "injectTo": [
          "source.go",
          "source.vuka"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.vuka-html": "html"
        }
      }
    ],
    "snippets": [
      {
        "language": "vuka",
        "path": "./snippets/vuka.json"
      },
      {
        "language": "vuka-html",
        "path": "./snippets/vuka-html.json"
      }
    ],
    "configurationDefaults": {
      "[vuka]": {
        "editor.formatOnSave": true,
        "editor.linkedEditing": true
      },
      "[vuka-html]": {
        "editor.formatOnSave": true,
        "editor.linkedEditing": true
      },
      "tailwindCSS.includeLanguages": {
        "vuka-html": "html",
        "vuka": "html"
      },
      "tailwindCSS.experimental.classRegex": [
        "\\bclass\\s*=\\s*\"([^\"]*)\"",
        [
          "\\bclass\\s*=\\s*\\{((?:[^{}]|\\{[^{}]*\\})*)\\}",
          "\"((?:[^\"\\\\]|\\\\.)*)\""
        ],
        [
          "\\bclass\\s*=\\s*\\{((?:[^{}]|\\{[^{}]*\\})*)\\}",
          "`([^`]*)`"
        ],
        [
          "\\b\\w*[cC]lass(?:es|Name)?(?<!\\bclass\\s*=\\s*\\{[^{}]*)\\(((?:[^()]|\\([^()]*\\))*)\\)",
          "\"((?:[^\"\\\\]|\\\\.)*)\""
        ],
        [
          "\\bfunc\\s+(?:\\([^)]*\\)\\s*)?\\w*[cC]lass(?:es|Name)?\\s*\\([^)]*\\)[^{\\n]*\\{([\\s\\S]*?)\\n\\}",
          "\"((?:[^\"\\\\]|\\\\.)*)\""
        ]
      ],
      "emmet.includeLanguages": {
        "vuka-html": "html"
      }
    },
    "configuration": {
      "title": "Vuka",
      "properties": {
        "vuka.path": {
          "type": "string",
          "default": "vuka",
          "description": "The vuka binary (install: go install github.com/vuka-lang/vuka/cmd/vuka/v2@latest).",
          "scope": "machine-overridable"
        },
        "vuka.goplsPath": {
          "type": "string",
          "default": "",
          "description": "The gopls binary vuka lsp runs. Empty: gopls on PATH, then $GOBIN, then $GOPATH/bin.",
          "scope": "machine-overridable"
        },
        "vuka.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace the messages between VS Code and vuka lsp."
        },
        "vuka.sharedGopls": {
          "type": "boolean",
          "default": true,
          "description": "Share one gopls daemon (gopls -remote=auto) between the Vuka server, the Go extension and other windows."
        },
        "vuka.offerGoDropIn": {
          "type": "boolean",
          "default": true,
          "description": "Offer to serve Go files through Vuka too (go.alternateTools.gopls), so .go files see code from .vuka files."
        },
        "vuka.offerTemplDropIn": {
          "type": "boolean",
          "default": true,
          "description": "Offer to let templ's language server use Vuka as its gopls (templ.executablePath), so .templ files see code from .vuka files."
        },
        "vuka.autoCloseTags": {
          "type": "boolean",
          "default": true,
          "description": "Add a closing tag when an opening tag in .vuka.html markup is finished by typing >, and the open element's name after </."
        }
      }
    },
    "commands": [
      {
        "command": "vuka.restartServer",
        "title": "Vuka: Restart Language Server"
      },
      {
        "command": "vuka.serveGoFiles",
        "title": "Vuka: Serve Go Files Too"
      },
      {
        "command": "vuka.stopServingGoFiles",
        "title": "Vuka: Stop Serving Go Files"
      },
      {
        "command": "vuka.serveTemplFiles",
        "title": "Vuka: Let templ Use Vuka as Its gopls"
      },
      {
        "command": "vuka.stopServingTemplFiles",
        "title": "Vuka: Stop templ Using Vuka"
      },
      {
        "command": "vuka.showRoute",
        "title": "Vuka: Show Routes"
      },
      {
        "command": "vuka.extractComponent",
        "title": "Vuka: Extract Component"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "vuka.extractComponent",
          "when": "false"
        }
      ]
    },
    "semanticTokenTypes": [
      {
        "id": "vukaProp",
        "superType": "property",
        "description": "A prop of a shape: an exported field, set by a tag's attribute or a page's URL."
      },
      {
        "id": "vukaState",
        "superType": "property",
        "description": "Server state of a shape: an unexported field the server keeps."
      },
      {
        "id": "vukaBrowserState",
        "superType": "variable",
        "description": "Browser state of a shape: a ui.State field the browser keeps."
      },
      {
        "id": "vukaEvent",
        "superType": "method",
        "description": "An event: a method an on… attribute sends to the server."
      },
      {
        "id": "vukaComponent",
        "superType": "class",
        "description": "A component tag."
      },
      {
        "id": "vukaLocal",
        "superType": "variable",
        "description": "A local a markup statement declares."
      },
      {
        "id": "vukaContextVar",
        "superType": "variable",
        "description": "A context processor's variable, read by name: user, request."
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "vuka-html",
        "scopes": {
          "vukaProp": [
            "variable.other.constant.property.prop.vuka",
            "variable.other.constant"
          ],
          "vukaState": [
            "variable.other.property.state.vuka",
            "variable.other.property"
          ],
          "vukaBrowserState": [
            "variable.language.browser-state.vuka",
            "variable.language"
          ],
          "vukaEvent": [
            "entity.name.function.event.vuka",
            "entity.name.function"
          ],
          "vukaComponent": [
            "entity.name.type.class.component.vuka",
            "entity.name.type.class",
            "support.class"
          ],
          "vukaLocal": [
            "variable.other.readwrite.local.vuka",
            "variable.other.readwrite"
          ],
          "vukaContextVar": [
            "variable.other.global.vuka",
            "variable.other.global"
          ]
        }
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.1",
    "shiki": "^2.5.0"
  },
  "scripts": {
    "package": "vsce package",
    "test": "node test/grammar.test.mjs && node test/jsx.test.mjs && node test/html.test.mjs && node test/toolchain.test.mjs && node test/shape.test.mjs && node test/editors.test.mjs && node test/routes.test.mjs && node test/refactor.test.mjs"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In an untrusted workspace the Vuka language server only runs from your user settings: the workspace's vuka.path and vuka.goplsPath are ignored.",
      "restrictedConfigurations": [
        "vuka.path",
        "vuka.goplsPath"
      ]
    }
  }
}
