package components

// icons are 24×24 stroked paths, drawn in currentColor.
var icons = map[string]string{
	"box":     "M21 8 12 3 3 8m18 0-9 5m9-5v8l-9 5m0-8L3 8m9 5v8M3 8v8l9 5",
	"logout":  "M15 4h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-3M10 17l5-5-5-5M15 12H3",
	"chevron": "m6 9 6 6 6-6",
	"error":   "M12 8v5m0 3.5h.01M10.3 3.9 2.4 18a2 2 0 0 0 1.7 3h15.8a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z",
	"success": "M9 12.5 11 14.5 15.5 10M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z",
	"info":    "M12 16v-4m0-4h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z",
}

// iconPath is the icon's path, a box for a name it doesn't know.
func iconPath(name string) string {
	if d, ok := icons[name]; ok {
		return d
	}
	return icons["box"]
}
