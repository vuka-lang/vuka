package users

import (
	"context"
	"strings"

	"github.com/vuka-lang/ui/v2"
	"github.com/vuka-lang/ui/v2/forms"
)

// Signup is the sign-up form: an employer posts jobs, a job seeker
// applies to them.
type Signup struct {
	ui.FormState
	Name     string `label:"Full name" validate:"required,max=100"`
	Email    string `validate:"required,email,max=254"`
	Password string `input:"new-password" validate:"required,min=12" help:"12 characters or more"`
	Role     string `label:"I want to" input:"radio" validate:"required"`
}

func (f *Signup) RoleChoices() []ui.Option {
	return []ui.Option{
		{Value: string(Role.Seeker), Label: "Find a job"},
		{Value: string(Role.Employer), Label: "Hire people"},
	}
}

func (f *Signup) CleanEmail(ctx context.Context) error {
	if forms.Live(ctx) {
		return nil
	}
	taken := User.Objects.Filter(User.Email.Eq(strings.ToLower(f.Email))).Exists(ctx)?
	if taken {
		return forms.Errorf("Someone already has an account with this email")
	}
	return nil
}
