# The settings the app reads: copy to .env (cp .env.example .env) and
# change what you need. In production, set real environment variables.

APP_NAME=Job Board
PORT=8080
DATABASE_URL=sqlite://data/app.db?_pragma=busy_timeout(5000)&_pragma=journal_mode(WAL)&_pragma=foreign_keys(1)

# The first admin, made at start-up when no user has this email.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-12-characters-or-more

# Mail is printed, not sent. In production set MAIL_DRIVER=smtp and
# MAIL_HOST, MAIL_PORT, MAIL_USERNAME, MAIL_PASSWORD, MAIL_ENCRYPTION.
MAIL_DRIVER=log
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=Job Board
