# generic: one generic table instantiated for tasks and for users on one
# page — each mounts (its row count) and keeps its page and sort in the URL
# under its own key, read on the first render and as the URL changes, and
# written by its events as patches keeping the other's parameters.
GET /?tasks.page=2&users.sort=date
LIVE /?tasks.page=2&users.sort=date
  expect Tasks: 3 rows, page 2, by name
  expect task c
  expect Users: 1 rows, page 1, by date
  {"type":"event","target":"c2:0","event":"click"}
  expect Tasks: 3 rows, page 3, by name
  {"type":"navigate","url":"/?tasks.page=3&users.sort=date","patch":true}
  {"type":"event","target":"c2:1","event":"click"}
  expect Tasks: 3 rows, page 3, by date
  {"type":"navigate","url":"/?tasks.page=3&tasks.sort=date&users.sort=date","patch":true}
  {"type":"event","target":"c3:0","event":"click"}
  expect Users: 1 rows, page 2, by date
  {"type":"navigate","url":"/?tasks.page=3&tasks.sort=date&users.page=2&users.sort=date","patch":true}
  {"type":"navigate","url":"/?tasks.page=2&users.sort=date","patch":true}
  expect Tasks: 3 rows, page 2, by name
  expect task c
  expect Users: 1 rows, page 1, by date
