package main

import "github.com/vuka-lang/ui"

// Card frames its children under a title, a footer in its slot; its
// script marks it seen, its style is its own.
type Card struct {
	Title    string
	Accent   string
	Wide     bool
	Footer   ui.Node
	Children ui.Node
}

func (c Card) Render() ui.Node {
	return <section class="card" class:wide={c.Wide} style:--accent={c.Accent}>
		<h3>{c.Title}</h3>
		<div class="body">{c.Children}</div>
		{if c.Footer != nil {
			<footer>{c.Footer}</footer>
		}}
		<script lang="ts">
			import { component } from 'vuka:component'
			export default component<Card>((el, props) => {
				el.dataset.seen = props.Title
				return { update(next) { el.dataset.seen = next.Title } }
			})
		</script>
		<style scoped>
			h3 { color: var(--accent) }
			.body { padding: 4px }
		</style>
	</section>
}
