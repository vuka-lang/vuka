package main

import (
	"context"
	"fmt"
	"strings"

	"github.com/vuka-lang/ui"
	"github.com/vuka-lang/web"
)

// NotePage is a note's page: its links patch it to the next note, its
// form edits the reply, its button navigates back to the board.
@web.Live("/notes/{id}")
type NotePage struct {
	ui.Live
	ID      int
	Reply   string @ui.Bind
	note    Note
	replies []string
	patches int
	notes   *Notes
}

// NoteParams is a patch's.
type NoteParams struct {
	web.URLParams
	ID int
}

// ReplyForm is the reply form's.
type ReplyForm struct {
	Text string `form:"text" validate:"required,max=20"`
}

@ui.Mount
func (p *NotePage) mount(ctx context.Context) error { return p.show(p.ID) }

func (p *NotePage) show(id int) error {
	n, ok := p.notes.Get(id)
	if !ok {
		return web.NotFound
	}
	p.ID, p.note = id, n
	return nil
}

// Update takes a patch to another note.
func (p *NotePage) Update(q NoteParams) error {
	p.patches++
	return p.show(q.ID)
}

// Send adds a reply.
func (p *NotePage) Send(ctx context.Context, f ReplyForm) error {
	if strings.Contains(f.Text, "!") {
		return web.Invalid{"text": "no shouting"}
	}
	p.replies = append(p.replies, f.Text)
	p.Reply = ""
	return nil
}

// Back navigates to the board.
func (p *NotePage) Back() { p.PushNavigate("/board?q=" + p.note.Text[:1]) }

func (p *NotePage) Render() ui.Node {
	return <article class="note">
		<h2>#{p.ID} {p.note.Text}</h2>
		<ul>
			{for i, r := range p.replies {
				<li key={i}>{r}</li>
			}}
		</ul>
		<form onSubmit={p.Send}>
			<input name="text" bind:value={p.Reply}/>
			<button>Reply</button>
		</form>
		<p>{fmt.Sprint(p.patches)} patches, typing {len(p.Reply)}</p>
		<ui.Link href={fmt.Sprint("/notes/", p.ID+1)} patch class="next">Next</ui.Link>
		<button onClick={p.Back}>Back</button>
	</article>
}
