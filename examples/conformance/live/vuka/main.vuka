// Command live is a notes board in Vuka: a page backed by its script
// island, with deferred fields, a bound and validated query in the URL and
// broadcasts; and a note's page, patched and navigated over the socket.
package main

import (
	"log"

	"example.com/app/notes"
	"example.com/app/pages"
	"github.com/vuka-lang/web"
)

func main() {
	app := web.New(pages.Routes())
	app.Service(notes.NewNotes)
	log.Fatal(app.Run(":" + web.Env("PORT", "8080")))
}
