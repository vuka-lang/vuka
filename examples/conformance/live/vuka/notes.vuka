package main

import (
	"strings"
	"sync"

	"github.com/vuka-lang/web"
)

// Note is a note of the board.
type Note struct {
	ID   int    `json:"id"`
	Text string `json:"text"`
}

// Notes holds the notes, in memory.
@web.Service
type Notes struct {
	mu   sync.Mutex
	list []Note
}

func Notes.New() *Notes {
	return &Notes{list: []Note{{1, "buy milk"}, {2, "call mum"}, {3, "write tests"}}}
}

// Add adds a note.
func (n *Notes) Add(text string) Note {
	n.mu.Lock()
	defer n.mu.Unlock()
	note := Note{len(n.list) + 1, text}
	n.list = append(n.list, note)
	return note
}

// Matching is the notes holding q.
func (n *Notes) Matching(q string) []Note {
	n.mu.Lock()
	defer n.mu.Unlock()
	var out []Note
	for _, note := range n.list {
		if strings.Contains(note.Text, q) {
			out = append(out, note)
		}
	}
	return out
}

// Get is the note id, if there is one.
func (n *Notes) Get(id int) (Note, bool) {
	n.mu.Lock()
	defer n.mu.Unlock()
	if id < 1 || id > len(n.list) {
		return Note{}, false
	}
	return n.list[id-1], true
}

// Count is how many notes there are.
func (n *Notes) Count() int {
	n.mu.Lock()
	defer n.mu.Unlock()
	return len(n.list)
}
