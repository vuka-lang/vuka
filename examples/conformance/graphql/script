# graphql: a schema from plain Go types and decorated functions — fields,
# methods with arguments and dependencies, enums, DateTime, IDs, nulls —
# queries with variables, aliases and fragments, a mutation taking a form
# (its rules and Clean method), gates, masked errors, limits, and the
# transport's answers over GET and POST.
POST /graphql json {"query":"{ pets(first: 10) { id name kind tag born price tricks age(at: \"2026-01-31\") owner { name email } } }"}
POST /graphql json {"query":"query Cats($k: Kind) { pets(kind: $k, first: 5) { ...Brief } } fragment Brief on Pet { id name }","variables":{"k":"CAT"}}
POST /graphql json {"query":"{ a: pet(id: 1) { name ownerID } b: pet(id: \"3\") { name __typename } missing: pet(id: 9) { name } }"}
POST /graphql json {"query":"{ pets(first: 1) { age(at: \"tomorrow\") } broken }"}
POST /graphql json {"query":"mutation { addPet(pet: {name: \"\", price: 0}) { id } }"}
POST /graphql json {"query":"mutation Add($p: NewPet) { addPet(pet: $p) { id name kind price tag } }","variables":{"p":{"name":"Rex","kind":"DOG","price":10}}}
POST /graphql json {"query":"mutation Add($p: NewPet) { addPet(pet: $p) { id name kind price tag } }","variables":{"p":{"name":"Bolt","kind":"DOG","price":10,"tag":"fast"}}}
POST /graphql json {"query":"mutation Adopt($o: ID) { addPet(pet: {name: \"Fido\", price: 5, ownerID: $o}) { id ownerID owner { name } } }","variables":{"o":"1"}}
