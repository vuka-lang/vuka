// Command islands-vue is a live page in Vuka placing a Vue island: its
// props following the page, its emit the page's event. It builds with Node.
package main

import (
	"log"

	"example.com/app/pages"
	"github.com/vuka-lang/web/v2"
)

func main() {
	app := web.New(pages.Routes())
	log.Fatal(app.Run(":" + web.Env("PORT", "8080")))
}
